{"step_index":1891,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-07T08:20:36Z","content":"Created At: 2026-10-07T13:50:36+05:30\nCompleted At: 2026-10-07T13:50:37+05:30\nFile Path: `file:///C:/Users/k4ran/OneDrive/Desktop/smartAGENT/smartagent/agent/core.py`\nTotal Lines: 254\nTotal Bytes: 8828\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: ReAct Agent Core for SmartAGENT.\n3: Implements the Thought → Action → Observation reasoning loop powered by Fluxnat Coder 3B.\n4: \"\"\"\n5: \n6: import re\n7: import time\n8: from typing import Optional, Generator, Tuple\n9: \n10: from rich.console import Console\n11: from rich.panel import Panel\n12: from rich.text import Text\n13: from rich.live import Live\n14: from rich.spinner import Spinner\n15: \n16: from smartagent.agent.memory import AgentMemory\n17: from smartagent.agent.tools import ToolRegistry\n18: from smartagent.agent.prompts import (\n19:     AGENT_SYSTEM_PROMPT,\n20:     REACT_OBSERVATION_PREFIX,\n21:     REACT_CONTINUE_PROMPT,\n22: )\n23: \n24: console = Console(legacy_windows=False)\n25: \n26: \n27: class SmartAgent:\n28:     \"\"\"\n29:     Autonomous security agent using a ReAct reasoning loop.\n30: \n31:     The agent thinks step-by-step, calls tools, observes results,\n32:     and continues until it has a Final Answer.\n33:     \"\"\"\n34: \n35:     def __init__(\n36:         self,\n37:         model_id: str = \"k4ran909/Fluxnat-Coder-3B\",\n38:         working_dir: str = \".\",\n39:         max_iterations: int = 15,\n40:         temperature: float = 0.3,\n41:         verbose: bool = True,\n42:     ):\n43:         self.model_id = model_id\n44:         self.working_dir = working_dir\n45:         self.max_iterations = max_iterations\n46:         self.temperature = temperature\n47:         self.verbose = verbose\n48: \n49:         self.tools = ToolRegistry(working_dir=working_dir)\n50:         self.memory = AgentMemory(max_messages=20)\n51:         self._model_manager = None  # lazy loaded\n52: \n53:     @property\n54:     def model_manager(self):\n55:         \"\"\"Lazy-load the model to avoid slow startup when not needed.\"\"\"\n56:         if self._model_manager is None:\n57:             from smartagent.ai.model import ModelManager\n58:             self._model_manager = ModelManager.get_instance(\n59:                 model_id=self.model_id, load_in_4bit=True\n60:             )\n61:         return self._model_manager\n62: \n63:     def run(self, user_message: str) -> str:\n64:         \"\"\"\n65:         Run the full agent loop for a single user message.\n66:         Returns the final answer string.\n67:         \"\"\"\n68:         # Build system prompt with tool descriptions\n69:         system_prompt = AGENT_SYSTEM_PROMPT.format(\n70:             tool_descriptions=self.tools.get_tool_descriptions()\n71:         )\n72: \n73:         # Initialize memory for this run if it's the first message\n74:         if not self.memory.messages:\n75:             self.memory.add_message(\"system\", system_prompt)\n76: \n77:         # Add the user message\n78:         self.memory.add_message(\"user\", user_message)\n79: \n80:         for iteration in range(1, self.max_iterations + 1):\n81:             if self.verbose:\n82:                 console.print(\n83:                     f\"  [dim]⟳ Step {iteration}/{self.max_iterations}[/dim]\",\n84:                     highlight=False,\n85:                 )\n86: \n87:             # Generate LLM response\n88:             messages = self.memory.get_messages()\n89:             try:\n90:                 llm_output = self.model_manager.generate(\n91:                     messages,\n92:                     max_tokens=512,\n93:                     temperature=self.temperature,\n94:                 )\n95:             except Exception as e:\n96:                 error_msg = f\"Model inference error: {e}\"\n97:                 if self.verbose:\n98:                     console.print(f\"  [red]✗ {error_msg}[/red]\")\n99:                 return f\"Error: {error_msg}\"\n100: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
