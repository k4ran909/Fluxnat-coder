{"step_index":1999,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-07T08:30:41Z","content":"Created At: 2026-10-07T14:00:41+05:30\nCompleted At: 2026-10-07T14:00:41+05:30\nFile Path: `file:///c:/Users/k4ran/OneDrive/Desktop/smartAGENT/scripts/run_colab_training.py`\nTotal Lines: 177\nTotal Bytes: 6372\nShowing lines 1 to 150\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: Fluxnat Coder 3B - Automated Colab Retraining Pipeline\n4: Downloads the expanded dataset (520 samples), executes QLoRA fine-tuning (65 steps),\n5: merges to 16-bit standalone model, and publishes to Hugging Face Hub.\n6: \"\"\"\n7: \n8: import os\n9: import json\n10: import random\n11: import urllib.request\n12: from pathlib import Path\n13: from datasets import Dataset\n14: from trl import SFTTrainer\n15: from transformers import TrainingArguments\n16: from unsloth import is_bfloat16_supported, FastLanguageModel\n17: \n18: print(\"=\" * 60)\n19: print(\"  Fluxnat Coder 3B - Red Team & Multi-CWE Retraining Pipeline\")\n20: print(\"=\" * 60)\n21: \n22: SYSTEM_PROMPT = (\n23:     \"You are Fluxnat Coder 3B, an elite AI cybersecurity and secure coding intelligence model created by Fluxnat. \"\n24:     \"Your mission is to perform rigorous source code vulnerability auditing, identify CWE and OWASP Top 10 security flaws, \"\n25:     \"explain attack surfaces and root causes using detailed step-by-step reasoning, and provide production-ready secure remediations.\"\n26: )\n27: \n28: REPO_RAW = \"https://raw.githubusercontent.com/k4ran909/Fluxnat-coder/main\"\n29: \n30: def download_jsonl(url):\n31:     name = url.split('/')[-1]\n32:     print(f\"[*] Downloading {name}...\")\n33:     req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})\n34:     response = urllib.request.urlopen(req)\n35:     data = response.read().decode('utf-8')\n36:     records = []\n37:     for line in data.strip().split('\\n'):\n38:         if line.strip():\n39:             records.append(json.loads(line))\n40:     return records\n41: \n42: # 1. Download curated datasets\n43: security_raw = download_jsonl(f\"{REPO_RAW}/data/custom_cot/security_cot.jsonl\")\n44: security_records = []\n45: for item in security_raw:\n46:     if 'messages' in item:\n47:         if item['messages'] and item['messages'][0]['role'] == 'system':\n48:             item['messages'][0]['content'] = SYSTEM_PROMPT\n49:         security_records.append(item)\n50: print(f\"[+] Loaded {len(security_records)} security CoT samples\")\n51: \n52: redteam_raw = download_jsonl(f\"{REPO_RAW}/data/custom_cot/redteam_cot.jsonl\")\n53: redteam_records = []\n54: for item in redteam_raw:\n55:     instruction = item.get('instruction', '')\n56:     inp = item.get('input', '')\n57:     output = item.get('output', '')\n58:     if inp:\n59:         instruction = f\"{instruction}\\n\\nCode/Input:\\n{inp}\"\n60:     if instruction and output:\n61:         redteam_records.append({\n62:             'messages': [\n63:                 {'role': 'system', 'content': SYSTEM_PROMPT},\n64:                 {'role': 'user', 'content': instruction.strip()},\n65:                 {'role': 'assistant', 'content': output.strip()}\n66:             ]\n67:         })\n68: print(f\"[+] Loaded {len(redteam_records)} red team CoT samples\")\n69: \n70: identity_raw = download_jsonl(f\"{REPO_RAW}/data/custom_cot/identity_alignment.jsonl\")\n71: identity_records = []\n72: for item in identity_raw:\n73:     if 'messages' in item:\n74:         if item['messages'] and item['messages'][0]['role'] == 'system':\n75:             item['messages'][0]['content'] = SYSTEM_PROMPT\n76:         identity_records.append(item)\n77: print(f\"[+] Loaded {len(identity_records)} identity alignment samples\")\n78: \n79: # 2. Build balanced training pool: 24*5 + 170*2 + 15*4 = 520 samples\n80: all_training = (security_records * 5) + (redteam_records * 2) + (identity_records * 4)\n81: random.seed(3407)\n82: random.shuffle(all_training)\n83: \n84: formatted_texts = [\n85:     tokenizer.apply_chat_template(item[\"messages\"], tokenize=False, add_generation_prompt=False)\n86:     for item in all_training\n87: ]\n88: train_dataset = Dataset.from_dict({\"text\": formatted_texts})\n89: print(f\"\\n[OK] Prepared {len(train_dataset)} balanced training sequences!\")\n90: print(f\"     - Security Audits: {len(security_records) * 5} ({len(security_records)} cases)\")\n91: print(f\"     - Red Team & ATT&CK: {len(redteam_records) * 2} ({len(redteam_records)} cases)\")\n92: print(f\"     - Identity Alignment: {len(identity_records) * 4} ({len(identity_records)} cases)\")\n93: \n94: # 3. Fine-tuning with SFTTrainer\n95: OUTPUT_DIR = \"./Fluxnat-Coder-3B-Adapters\"\n96: training_args = TrainingArguments(\n97:     output_dir=OUTPUT_DIR,\n98:     per_device_train_batch_size=2,\n99:     gradient_accumulation_steps=4,\n100:     warmup_steps=5,\n101:     max_steps=65,\n102:     learning_rate=8e-5,\n103:     fp16=not is_bfloat16_supported(),\n104:     bf16=is_bfloat16_supported(),\n105:     logging_steps=5,\n106:     optim=\"adamw_8bit\",\n107:     weight_decay=0.01,\n108:     lr_scheduler_type=\"cosine\",\n109:     seed=3407,\n110: )\n111: \n112: trainer = SFTTrainer(\n113:     model=model,\n114:     tokenizer=tokenizer,\n115:     train_dataset=train_dataset,\n116:     dataset_text_field=\"text\",\n117:     max_seq_length=4096,\n118:     dataset_num_proc=2,\n119:     packing=False,\n120:     args=training_args,\n121: )\n122: \n123: print(f\"\\n[*] Starting training: {training_args.max_steps} steps, lr={training_args.learning_rate}...\")\n124: trainer_stats = trainer.train()\n125: \n126: print(f\"\\n[OK] Training Complete!\")\n127: print(f\"     Final Loss: {trainer_stats.training_loss:.4f}\")\n128: print(f\"     Total Steps: {trainer_stats.global_step}\")\n129: print(f\"     Runtime: {trainer_stats.metrics['train_runtime']:.1f}s\")\n130: \n131: # 4. Merge to 16-bit standalone model\n132: MERGED_DIR = \"./Fluxnat-Coder-3B-Merged\"\n133: print(f\"\\n[*] Merging LoRA adapters into standalone 16-bit model: {MERGED_DIR}...\")\n134: model.save_pretrained_merged(MERGED_DIR, tokenizer, save_method=\"merged_16bit\")\n135: \n136: cfg_path = Path(MERGED_DIR) / \"config.json\"\n137: if cfg_path.exists():\n138:     with open(cfg_path, 'r') as f:\n139:         c = json.load(f)\n140:     c[\"_name_or_path\"] = \"k4ran909/Fluxnat-Coder-3B\"\n141:     c[\"model_name\"] = \"Fluxnat-Coder-3B\"\n142:     c[\"model_author\"] = \"Fluxnat\"\n143:     with open(cfg_path, 'w') as f:\n144:         json.dump(c, f, indent=2)\n145: \n146: print(\"[OK] Standalone model merged and rebranded successfully!\")\n147: \n148: # 5. Push to Hugging Face Hub\n149: from huggingface_hub import HfApi\n150: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
