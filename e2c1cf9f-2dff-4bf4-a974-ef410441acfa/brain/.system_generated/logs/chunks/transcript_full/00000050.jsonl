or tc in tcalls]))\n\nprint(f'Extracted {len(turns)} dialogue turns.')\nuser_count = sum(1 for t in turns if t[0] == 'USER')\nmodel_count = sum(1 for t in turns if t[0] == 'MODEL')\nprint(f'User turns: {user_count}, Model turns: {model_count}')\n\"","Cwd":"c:\\Users\\k4ran\\OneDrive\\Desktop\\smartAGENT","IsDaemon":false,"WaitMsBeforeAsync":5000,"toolAction":"Testing dialogue extraction","toolSummary":"Test dialogue turn extraction"}}]}
