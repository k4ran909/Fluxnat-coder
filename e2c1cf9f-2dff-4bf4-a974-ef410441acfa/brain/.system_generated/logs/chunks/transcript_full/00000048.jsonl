{"step_index":1919,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-07T08:22:22Z","content":"Created At: 2026-10-07T13:52:22+05:30\nCompleted At: 2026-10-07T13:52:23+05:30\nFile Path: `file:///C:/Users/k4ran/OneDrive/Desktop/smartAGENT/smartagent/cli.py`\nTotal Lines: 264\nTotal Bytes: 9964\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: SmartAGENT CLI Entry Point.\n3: Provides commands to scan projects for vulnerabilities and launch Fluxnat Coder 3B training.\n4: \"\"\"\n5: \n6: import os\n7: import sys\n8: from pathlib import Path\n9: from typing import Optional, List\n10: import typer\n11: from rich.console import Console\n12: from rich.panel import Panel\n13: \n14: # Ensure UTF-8 output on Windows consoles\n15: if sys.platform == \"win32\":\n16:     try:\n17:         sys.stdout.reconfigure(encoding=\"utf-8\")\n18:         sys.stderr.reconfigure(encoding=\"utf-8\")\n19:     except Exception:\n20:         pass\n21: \n22: from smartagent.config import get_default_config\n23: from smartagent.scanners import ALL_SCANNERS, Finding\n24: from smartagent.reporting import (\n25:     print_rich_report,\n26:     export_json_report,\n27:     export_markdown_report,\n28: )\n29: \n30: app = typer.Typer(\n31:     name=\"smartagent\",\n32:     help=\"SmartAGENT - AI-Powered Cybersecurity Vulnerability Scanner & Fluxnat Coder 3B Suite\",\n33:     add_completion=False,\n34: )\n35: console = Console(legacy_windows=False)\n36: \n37: \n38: @app.command(\"scan\")\n39: def scan_project(\n40:     target_dir: str = typer.Argument(\".\", help=\"Directory or file path to scan\"),\n41:     ai_verify: bool = typer.Option(False, \"--ai\", \"-a\", help=\"Use Fluxnat Coder 3B for false-positive reduction & fix generation\"),\n42:     model_id: Optional[str] = typer.Option(None, \"--model\", \"-m\", help=\"Hugging Face model ID or path to merged model\"),\n43:     json_out: Optional[str] = typer.Option(None, \"--json\", \"-j\", help=\"Path to write JSON report\"),\n44:     md_out: Optional[str] = typer.Option(None, \"--md\", help=\"Path to write Markdown report\"),\n45: ):\n46:     \"\"\"\n47:     Perform an automated vulnerability audit on a project codebase.\n48:     \"\"\"\n49:     config = get_default_config()\n50:     target_path = Path(target_dir).resolve()\n51: \n52:     if not target_path.exists():\n53:         console.print(f\"[bold red]Error:[/bold red] Target path does not exist: {target_path}\")\n54:         raise typer.Exit(code=1)\n55: \n56:     console.print(Panel(\n57:         f\"[bold cyan]SmartAGENT Vulnerability Audit[/bold cyan]\\n\"\n58:         f\"Scanning: [white]{target_path}[/white]\\n\"\n59:         f\"Scanners Active: [green]{len(ALL_SCANNERS)}[/green] (Secrets, Code Patterns, Dependencies, Configs)\\n\"\n60:         f\"AI Verification: [yellow]{'Enabled (Fluxnat Coder 3B)' if ai_verify else 'Disabled (Static Pass Only)'}[/yellow]\",\n61:         title=\"⚡ Initializing Audit\",\n62:         expand=False\n63:     ))\n64: \n65:     all_findings: List[Finding] = []\n66: \n67:     # File traversal\n68:     files_to_scan: List[Path] = []\n69:     if target_path.is_file():\n70:         files_to_scan.append(target_path)\n71:     else:\n72:         for root, dirs, files in os.walk(target_path):\n73:             # Prune ignored directories\n74:             dirs[:] = [d for d in dirs if d not in config.ignored_directories]\n75:             for file in files:\n76:                 fpath = Path(root) / file\n77:                 if any(file.endswith(ext) or file == ext for ext in config.target_extensions):\n78:                     # Check file size\n79:                     try:\n80:                         if fpath.stat().st_size <= config.max_file_size_kb * 1024:\n81:                             files_to_scan.append(fpath)\n82:                     except Exception:\n83:                         pass\n84: \n85:     console.print(f\"[*] Analyzing [cyan]{len(files_to_scan)}[/cyan] matching project files...\")\n86: \n87:     with console.status(\"[bold green]Running static analysis rules...\") as status:\n88:         for fpath in files_to_scan:\n89:             try:\n90:                 with open(fpath, \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n91:                     content = f.read()\n92: \n93:                 rel_path = str(fpath.relative_to(target_path)) if target_path.is_dir() else str(fpath.name)\n94:                 for scanner in ALL_SCANNERS:\n95:                     findings = scanner.scan_file(rel_path, content)\n96:                     all_findings.extend(findings)\n97:             except Exception as e:\n98:                 pass\n99: \n100:     console.print(f\"[✓] Static analysis complete. Identified [bold red]{len(all_findings)}[/bold red] potential findings.\")\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
