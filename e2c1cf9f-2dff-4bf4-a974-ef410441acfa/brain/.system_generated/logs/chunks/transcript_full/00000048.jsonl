_spec: str) -> str:\n269:         # Parse optional line range: path:start-end\n270:         start_line, end_line = None, None\n271:         if \":\" in path_spec and \"-\" in path_spec.rsplit(\":\", 1)[-1]:\n272:             parts = path_spec.rsplit(\":\", 1)\n273:             path_str = parts[0]\n274:             try:\n275:                 range_parts = parts[1].split(\"-\")\n276:                 start_line = int(range_parts[0])\n277:                 end_line = int(range_parts[1])\n278:             except (ValueError, IndexError):\n279:                 path_str = path_spec  # not a valid range, treat whole thing as path\n280:         else:\n281:             path_str = path_spec\n282: \n283:         full_path = os.path.abspath(os.path.join(self.working_dir, path_str.strip()))\n284:         if not os.path.isfile(full_path):\n285:             return f\"Error: File '{path_str}' not found.\"\n286: \n287:         try:\n288:             with open(full_path, \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n289:                 lines = f.readlines()\n290:         except Exception as e:\n291:             return f\"Error reading file: {e}\"\n292: \n293:         total = len(lines)\n294:         if start_line and end_line:\n295:             start_line = max(1, start_line)\n296:             end_line = min(total, end_line)\n297:             selected = lines[start_line - 1:end_line]\n298:             numbered = [f\"{i}: {line.rstrip()}\" for i, line in enumerate(selected, start=start_line)]\n299:             return f\"File: {path_str} (lines {start_line}-{end_line} of {total})\\n\" + \"\\n\".join(numbered)\n300:         else:\n301:             # Cap at 200 lines to prevent context overflow\n302:             if total > 200:\n303:                 selected = lines[:200]\n304:                 numbered = [f\"{i}: {line.rstrip()}\" for i, line in enumerate(selected, start=1)]\n305:                 return f\"File: {path_str} ({total} lines, showing first 200)\\n\" + \"\\n\".join(numbered)\n306:             numbered = [f\"{i}: {line.rstrip()}\" for i, line in enumerate(lines, start=1)]\n307:             return f\"File: {path_str} ({total} lines)\\n\" + \"\\n\".join(numbered)\n308: \n309:     def _tool_search_code(self, pattern: str) -> str:\n310:         pattern = pattern.strip()\n311:         if not pattern:\n312:             return \"Error: Please provide a search pattern.\"\n313: \n314:         try:\n315:             regex = re.compile(pattern, re.IGNORECASE)\n316:         except re.error as e:\n317:             return f\"Error: Invalid regex pattern: {e}\"\n318: \n319:         matches = []\n320:         code_extensions = {\n321:             \".py\", \".js\", \".ts\", \".jsx\", \".tsx\", \".go\", \".java\", \".php\",\n322:             \".c\", \".cpp\", \".h\", \".rs\", \".rb\", \".sql\", \".sh\",\n323:         }\n324:         for root, dirs, filenames in os.walk(self.working_dir):\n325:             dirs[:] = [d for d in dirs if d not in IGNORE_DIRS]\n326:             for fname in filenames:\n327:                 ext = os.path.splitext(fname)[1].lower()\n328:                 if ext not in code_extensions:\n329:                     continue\n330:                 fpath = os.path.join(root, fname)\n331:                 try:\n332:                     with open(fpath, \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n333:                         for line_num, line in enumerate(f, 1):\n334:                             if regex.search(line):\n335:                                 rel = os.path.relpath(fpath, self.working_dir)\n336:                                 matches.append(f\"  {rel}:{line_num}: {line.strip()}\")\n337:                                 if len(matches) >= 50:\n338:                                     break\n339:                 except Exception:\n340:                     continue\n341:                 if len(matches) >= 50:\n342:                     break\n343: \n344:         if not matches:\n345:             return f\"No matches