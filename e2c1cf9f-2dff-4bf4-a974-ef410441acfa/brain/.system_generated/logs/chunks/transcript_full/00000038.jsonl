e-Tuning\"\r\n554:    ]\r\n555:   },\r\n556:   {\r\n557:    \"cell_type\": \"code\",\r\n558:    \"execution_count\": null,\r\n559:    \"metadata\": {\r\n560:     \"id\": \"bBtUZIG4wjco\"\r\n561:    },\r\n562:    \"outputs\": [],\r\n563:    \"source\": [\r\n564:     \"from trl import SFTTrainer\\n\",\r\n565:     \"from transformers import TrainingArguments\\n\",\r\n566:     \"from unsloth import is_bfloat16_supported\\n\",\r\n567:     \"\\n\",\r\n568:     \"OUTPUT_DIR = \\\"./Fluxnat-Coder-3B-Adapters\\\"\\n\",\r\n569:     \"\\n\",\r\n570:     \"# Calibrated Training Arguments for Expanded Multi-CWE Dataset:\\n\",\r\n571:     \"# - max_steps=35: Trains ~2 epochs over 148 samples (effective batch size = 8)\\n\",\r\n572:     \"# - learning_rate=1e-4: Maintains healthy convergence (~0.55-0.75 loss) without capacity collapse\\n\",\r\n573:     \"# - warmup_steps=3: Smooth adapter weight initialization\\n\",\r\n574:     \"training_args = TrainingArguments(\\n\",\r\n575:     \"    output_dir=OUTPUT_DIR,\\n\",\r\n576:     \"    per_device_train_batch_size=2,\\n\",\r\n577:     \"    gradient_accumulation_steps=4,\\n\",\r\n578:     \"    warmup_steps=3,\\n\",\r\n579:     \"    max_steps=35,             # 2 full epochs over 148 balanced samples (~90-120s on Tesla T4)\\n\",\r\n580:     \"    learning_rate=1e-4,\\n\",\r\n581:     \"    fp16=not is_bfloat16_supported(),\\n\",\r\n582:     \"    bf16=is_bfloat16_supported(),\\n\",\r\n583:     \"    logging_steps=2,\\n\",\r\n584:     \"    optim=\\\"adamw_8bit\\\",\\n\",\r\n585:     \"    weight_decay=0.01,\\n\",\r\n586:     \"    lr_scheduler_type=\\\"cosine\\\",\\n\",\r\n587:     \"    seed=3407,\\n\",\r\n588:     \")\\n\",\r\n589:     \"\\n\",\r\n590:     \"trainer = SFTTrainer(\\n\",\r\n591:     \"    model=model,\\n\",\r\n592:     \"    tokenizer=tokenizer,\\n\",\r\n593:     \"    train_dataset=train_dataset,\\n\",\r\n594:     \"    dataset_text_field=\\\"text\\\",\\n\",\r\n595:     \"    max_seq_length=MAX_SEQ_LENGTH,\\n\",\r\n596:     \"    dataset_num_proc=2,\\n\",\r\n597:     \"    packing=False,\\n\",\r\n598:     \"    args=training_args,\\n\",\r\n599:     \")\\n\",\r\n600:     \"\\n\",\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":1676,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-07T07:08:30Z","content":"Now I have the full picture. The notebook's Step 4 currently has all samples inline (~450 lines). I'll write an updater script that replaces Step 4 with a clean version that downloads processed data from GitHub, and updates Step 5 with higher max_steps:","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"#!/usr/bin/env python3\n\"\"\"Update Fluxnat_Coder_3B_Training.ipynb for the expanded 520-sample dataset.\n\nChanges:\n  - Step 4: Replace inline samples with GitHub raw download of processed data\n  - Step 5: Increase max_steps from 35 to 65 for larger dataset\n\"\"\"\n\nimport json\nimport os\n\nNOTEBOOK = os.path.join(os.path.dirname(os.path.dirname(__file__)),\n                        \"Fluxnat_Coder_3B_Training.ipynb\")\n\n# New Step 4 cell source — downloads processed data from GitHub instead of inline\nSTEP4_SOURCE = [\n    \"import json\\\\n\",\n    \"import random\\\\n\",\n    \"import urllib.request\\\\n\",\n    \"from datasets import Dataset\\\\n\",\n    \"\\\\n\",\n    \"SYSTEM_PROMPT = (\\\\n\",\n    \"    \\\\\"You are Fluxnat Coder 3B, an elite AI cybersecurity and secure coding intelligence model created by Fluxnat. \\\\\"\\\\n\",\n    \"    \\\\\"Your mission is to perform rigorous source code vulnerability auditing, identify CWE and OWASP Top 10 security flaws, \\\\\"\\\\n\",\n    \"    \\\\\"explain attack surfaces and root causes using detailed step-by-step reasoning, and provide production-ready secure remediations.\\\\\"\\\\n\",\n    \")\\\\n\",\n    \"\\\\n\",\n    \"REPO_RAW = \\\\\"https://raw.githubusercontent.com/k4ran909/Fluxnat-coder/main\\\\\"\\\\n\",\n    \"\\\\n\",\n    \"def download_jsonl(url):\\\\n\",\n    \"    \\\\\"\\\\\"\\\\\"Download a JSONL file and return list of parsed dicts.\\\\\"\\\\\"\\\\\"\\\\n\",\n    \"    print(f\\\\\"[*] Downloading {url.split('/')[-1]}...\\\\\")\\\\n\",\n    \"    response = urllib.request.urlopen(url)\\\\n\",\n    \"    data = response.read().decode('utf-8')\\\\n\",\n    \"    records = []\\\\n\",\n    \"    for line in data.strip().split('\\\\\\\\n'):\\\\n\",\n    \"        if line.strip():\\\\n\",\n    \"            records.append(json.loads(line))\\\\n\",\n    \"    return records\\\\n\",\n    \"\\\\n\",\n    \"# 1. Download curated security CoT samples (24 samples, messages format)\\\\n\",\n    \"security_raw = download_jsonl(f\\\\\"{REPO_RAW}/data/custom_cot/security_cot.jsonl\\\\\")\\\\n\",\n    \"security_records = []\\\\n\",\n    \"for item in security_raw:\\\\n\",\n    \"    if 'messages' in item:\\\\n\",\n    \"        if item['messages'] and item['messages'][0]['role'] == 'system':\\\\n\",\n    \"            item['messages'][0]['content'] = SYSTEM_PROMPT\\\\n\",\n    \"        security_records.append(item)\\\\n\",\n    \"print(f\\\\\"[+] Loaded {len(security_records)} security CoT samples\\\\\")\\\\n\",\n    \"\\\\n\",\n    \"# 2. Download red team offensive security samples (170 samples, instruction/output format)\\\\n\",\n    \"redteam_raw = download_jsonl(f\\\\\"{REPO_RAW}/data/custom_cot/redteam_cot.jsonl\\\\\")\\\\n\",\n    \"redteam_records = []\\\\n\",\n    \"for item in redteam_raw:\\\\n\",\n    \"    instruction = item.get('instruction', '')\\\\n\",\n    \"    inp = item.get('input', '')\\\\n\",\n    \"    output = item.get('output', '')\\\\n\",\n    \"    if inp:\\\\n\",\n    \"        instruction = f\\\\\"{instruction}\\\\\\\\n\\\\\\\\nCode/Input:\\\\\\\\n{inp}\\\\\"\\\\n\",\n    \"    if instruction and output:\\\\n\",\n    \"        redteam_records.append({\\\\n\",\n    \"            'messages': [\\\\n\",\n    \"                {'role': 'system', 'content': SYSTEM_PROMPT},\\\\n\",\n    \"                {'role': 'user', 'content': instruction.strip()},\\\\n\",\n    \"                {'role': 'assistant', 'content': output.strip()}\\\\n\",\n    \"            ]\\\\n\",\n    \"        })\\\\n\",\n    \"print(f\\\\\"[+] Loaded {len(redteam_records)} red team CoT samples\\\\\")\\\\n\",\n    \"\\\\n\",\n    \"# 3. Download identity alignment samples\\\\n\",\n    \"identity_raw = download_jsonl(f\\\\\"{REPO_RAW}/data/custom_cot/identity_alignment.jsonl\\\\\")\\\\n\",\n    \"identity_records = []\\\\n\",\n    \"for item in identity_raw:\\\\n\",\n    \"    if 'messages' in item:\\\\n\",\n    \"        if item['messages'] and item['messages'][0]['role'] == 'system':\\\\n\",\n    \"            item['messages'][0]['content'] = SYSTEM_PROMPT\\\\n\",\n    \"        identity_records.append(item)\\\\n\",\n    \"print(f\\\\\"[+] Loaded {len(identity_records)} identity alignment samples\\\\\")\\\\n\",\n    \"\\\\n\",\n    \"# 4. Build balanced training mix\\\\n\",\n    \"# Security CoT (24) x5 = 120, Red Team (170) x2 = 340, Identity (15) x4 = 60 => ~520 total\\\\n\",\n    \"all_training = (security_records * 5) + (redteam_records * 2) + (identity_records * 4)\\\\n\",\n    \"random.seed(3407)\\\\n\",\n    \"random.shuffle(all_training)\\\\n\",\n    \"\\\\n\",\n    \"formatted_texts = [\\\\n\",\n    \"    tokenizer.apply_chat_template(item[\\\\\"messages\\\\\"], tokenize=False, add_generation_prompt=False)\\\\n\",\n    \"    for item in all_training\\\\n\",\n    \"]\\\\n\",\n    \"train_dataset = Dataset.from_dict({\\\\\"text\\\\\": formatted_texts})\\\\n\",\n    \"print(f\\\\\"\\\\\\\\n[OK] Prepared {len(train_dataset)} expanded training sequences!\\\\\")\\\\n\",\n    \"print(f\\\\\"     - Security Audits: {len(security_records) * 5} ({len(security_records)} distinct CWE cases)\\\\\")\\\\n\",\n    \"print(f\\\\\"     - Red Team / Offensive: {len(redteam_records) * 2} ({len(redteam_records)} exploit chains, payloads, attack techniques)\\\\\")\\\\n\",\n    \"print(f\\\\\"     - Identity Alignment: {len(identity_records) * 4} ({len(identity_records)} identity prompts)\\\\\")\\\\n\",\n    \"\\\\n\"\n]\n\n# New Step 5 training config — increased steps for 520 samples\nSTEP5_SOURCE = [\n    \"from trl import SFTTrainer\\\\n\",\n    \"from transformers import TrainingArguments\\\\n\",\n    \"from unsloth import is_bfloat16_supported\\\\n\",\n    \"\\\\n\",\n    \"OUTPUT_DIR = \\\\\"./Fluxnat-Coder-3B-Adapters\\\\\"\\\\n\",\n    \"\\\\n\",\n    \"# Calibrated Training Arguments for Expanded 520-Sample Dataset:\\\\n\",\n    \"# - max_steps=65: ~4 epochs over 520 samples (effective batch size = 8 -> 65 steps/epoch)\\\\n\",\n    \"# - learning_rate=8e-5: Slightly lower LR for larger dataset to prevent overfitting\\\\n\",\n    \"# - warmup_steps=5: Gradual warmup for stable convergence\\\\n\",\n    \"training_args = TrainingArguments(\\\\n\",\n    \"    output_dir=OUTPUT_DIR,\\\\n\",\n    \"    per_device_train_batch_size=2,\\\\n\",\n    \"    gradient_accumulation_steps=4,\\\\n\",\n    \"    warmup_steps=5,\\\\n\",\n    \"    max_steps=65,             # ~1 epoch over 520 samples (effective batch 8 -> 65 steps) ~3-5 min on T4\\\\n\",\n    \"    learning_rate=8e-5,\\\\n\",\n    \"    fp16=not is_bfloat16_supported(),\\\\n\",\n    \"    bf16=is_bfloat16_supported(),\\\\n\",\n    \"    logging_steps=5,\\\\n\",\n    \"    optim=\\\\\"adamw_8bit\\\\\",\\\\n\",\n    \"    weight_decay=0.01,\\\\n\",\n    \"    lr_scheduler_type=\\\\\"cosine\\\\\",\\\\n\",\n    \"    seed=3407,\\\\n\",\n    \")\\\\n\",\n    \"\\\\n\",\n    \"trainer = SFTTrainer(\\\\n\",\n    \"    model=model,\\\\n\",\n    \"    tokenizer=tokenizer,\\\\n\",\n    \"    train_dataset=train_dataset,\\\\n\",\n    \"    dataset_text_field=\\\\\"text\\\\\",\\\\n\",\n    \"    max_seq_length=MAX_SEQ_LENGTH,\\\\n\",\n    \"    dataset_num_proc=2,\\\\n\",\n    \"    packing=False,\\\\n\",\n    \"    args=training_args,\\\\n\",\n    \")\\\\n\",\n    \"\\\\n\",\n    \"print(f\\\\\"[OK] SFTTrainer ready: {training_args.max_steps} steps, batch={training_args.per_device_train_batch_size}x{training_args.gradient_accumulation_steps}\\\\\")\\\\n\",\n    \"print(f\\\\\"     LR={training_args.learning_rate}, warmup={training_args.warmup_steps}, scheduler={training_args.lr_scheduler_type}\\\\\")\\\\n\",\n    \"\\\\n\",\n    \"trainer_stats = trainer.train()\\\\n\",\n    \"\\\\n\",\n    \"print(f\\\\\"\\\\\\\\n[OK] Training Complete!\\\\\")\\\\n\",\n    \"print(f\\\\\"     Final Loss: {trainer_stats.training_loss:.4f}\\\\\")\\\\n\",\n    \"print(f\\\\\"     Total Steps: {trainer_stats.global_step}\\\\\")\\\\n\",\n    \"print(f\\\\\"     Runtime: {trainer_stats.metrics['train_runtime']:.1f}s\\\\\")\\\\n\"\n]\n\n\ndef main():\n    with open(NOTEBOOK, \"r\", encoding=\"utf-8\") as f:\n        nb = json.load(f)\n\n    cells = nb[\"cells\"]\n    step4_idx = None\n    step5_idx = None\n\n    # Find Step 4 and Step 5 code cells\n    for i, cell in enumerate(cells):\n        src = \"\".join(cell.get(\"source\", []))\n        if \"Step 4\" in src and cell[\"cell_type\"] == \"markdown\":\n            # The code cell is the next one\n            step4_idx = i + 1\n        if \"Step 5\" in src and cell[\"cell_type\"] == \"markdown\":\n            step5_idx = i + 1\n\n    if step4_idx is None or step5_idx is None:\n        print(\"[!] Could not find Step 4 or Step 5 cells\")\n        return\n\n    print(f\"[*] Updating Step 4 (cell {step4_idx}): GitHub download dataset\")\n    cells[step4_idx][\"source\"] = STEP4_SOURCE\n    cells[step4_idx][\"outputs\"] = []\n\n    print(f\"[*] Updating Step 5 (cell {step5_idx}): max_steps=65, lr=8e-5\")\n    cells[step5_idx][\"source\"] = STEP5_SOURCE\n    cells[step5_idx][\"outputs\"] = []\n\n    with open(NOTEBOOK, \"w\", encoding=\"utf-8\") as f:\n        json.dump(nb, f, indent=1, ensure_ascii=False)\n\n    print(\"[OK] Notebook updated successfully!\")\n    print(\"     Step 4: Downloads security_cot + redteam_cot + identity from GitHub\")\n    print(\"     Step 5: max_steps=65, lr=8e-5, warmup=5, logging=5\")\n\n\nif __name__ == \"__main__\":\n    main()\n","Description":"Script to update the Colab training notebook: replaces the massive inline dataset cell with a clean GitHub-download approach, and increases training steps from 35 to 65 for the larger 520-sample dataset.","Overwrite":true,"TargetFile":"c:\\Users\\k4ran\\OneDrive\\Desktop\\smartAGENT\\scripts\\update_notebook_v2.py","toolAction":"Creating notebook updater","toolSummary":"Notebook update script"}}]}
