  res.send('Compressed');\n40:     });\n41: });\"\"\"\n42:     },\n43:     {\n44:         \"id\": \"TC-03\",\n45:         \"name\": \"Path Traversal (Python)\",\n46:         \"is_vulnerable\": True,\n47:         \"expected_cwe\": \"CWE-22\",\n48:         \"code\": \"\"\"@app.route('/files')\n49: def get_file():\n50:     target = request.args.get('path')\n51:     full_path = os.path.join('/data/storage', target)\n52:     return open(full_path, 'rb').read()\"\"\"\n53:     },\n54:     {\n55:         \"id\": \"TC-04\",\n56:         \"name\": \"Hardcoded Secret (Python)\",\n57:         \"is_vulnerable\": True,\n58:         \"expected_cwe\": \"CWE-798\",\n59:         \"code\": \"\"\"AWS_ACCESS_KEY = \"AKIAIOSFODNN7EXAMPLE\"\n60: AWS_SECRET_KEY = \"wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY\"\n61: \n62: def connect_s3():\n63:     return boto3.client('s3', aws_access_key_id=AWS_ACCESS_KEY, aws_secret_access_key=AWS_SECRET_KEY)\"\"\"\n64:     },\n65:     {\n66:         \"id\": \"TC-05\",\n67:         \"name\": \"Benign Clean Code (Parameterized Query)\",\n68:         \"is_vulnerable\": False,\n69:         \"expected_cwe\": \"None\",\n70:         \"code\": \"\"\"def get_user_by_email(email: str):\n71:     conn = get_db_connection()\n72:     cursor = conn.cursor()\n73:     cursor.execute(\"SELECT id, email, created_at FROM users WHERE email = %s\", (email,))\n74:     return cursor.fetchone()\"\"\"\n75:     }\n76: ]\n77: \n78: \n79: def run_benchmark(model_path: str = \"./outputs/Fluxnat-Coder-3B-Merged\"):\n80:     \"\"\"Evaluate model on benchmark test suite.\"\"\"\n81:     if not os.path.exists(model_path):\n82:         fallback = \"./outputs/Fluxnat-Coder-3B\"\n83:         if os.path.exists(fallback):\n84:             model_path = fallback\n85:         else:\n86:             print(f\"[*] Local model not found at {model_path}. Loading hub model: k4ran909/Fluxnat-Coder-3B...\")\n87:             model_path = \"k4ran909/Fluxnat-Coder-3B\"\n88: \n89:     print(f\"[*] Loading model