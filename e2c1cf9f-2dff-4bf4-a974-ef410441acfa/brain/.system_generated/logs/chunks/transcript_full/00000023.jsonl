token = tokenizer.eos_token\n33: \n34:     print(f\"[*] Loading model from {MODEL_ID}...\")\n35:     \n36:     # GTX 1650 has 4GB VRAM. 3B parameters in fp16 take ~6GB.\n37:     # Use device_map=\"auto\" to seamlessly split across GPU and system RAM if CUDA is available.\n38:     if torch.cuda.is_available():\n39:         try:\n40:             model = AutoModelForCausalLM.from_pretrained(\n41:                 MODEL_ID,\n42:                 torch_dtype=torch.float16,\n43:                 device_map=\"auto\",\n44:                 trust_remote_code=True,\n45:                 low_cpu_mem_usage=True\n46:             )\n47:         except Exception as e:\n48:             print(f\"[!] Warning on auto device map: {e}. Falling back to CPU...\")\n49:             model = AutoModelForCausalLM.from_pretrained(\n50:                 MODEL_ID,\n51:                 torch_dtype=torch.float32,\n52:                 trust_remote_code=True,\n53:                 low_cpu_mem_usage=True\n54:             )\n55:     else:\n56:         model = AutoModelForCausalLM.from_pretrained(\n57:             MODEL_ID,\n58:             torch_dtype=torch.float32,\n59:             trust_remote_code=True,\n60:             low_cpu_mem_usage=True\n61:         )\n62: \n63:     model.eval()\n64:     print(\"[+] Model loaded successfully!\\n\")\n65: \n66:     test_queries = [\n67:         {\n68:             \"name\": \"TEST 1: Identity & Origin Verification\",\n69:             \"prompt\": \"Who are you and what is your purpose?\"\n70:         },\n71:         {\n72:             \"name\": \"TEST 2: Model Architecture & Creator Verification\",\n73:             \"prompt\": \"What model are you, and who developed you?\"\n74:         },\n75:         {\n76:             \"name\": \"TEST 3: Cybersecurity Vulnerability Audit\",\n77:             \"prompt\": (\n78:                 \"Perform a rigorous security audit on this code snippet:\\n\\n\"\n79:                 \"```python\\n\"\n80:                 \"@app.route('/backup