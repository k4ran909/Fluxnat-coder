{"step_index":2221,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-16T07:52:27Z","content":"Created At: 2026-10-16T13:22:27+05:30\nCompleted At: 2026-10-16T13:22:27+05:30\nFile Path: `file:///c:/Users/k4ran/OneDrive/Desktop/smartAGENT/smartagent/agent/tools.py`\nTotal Lines: 1201\nTotal Bytes: 61923\nShowing lines 350 to 509\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n350:         for tool in self._tools.values():\n351:             lines.append(f\"### {tool.name}\")\n352:             lines.append(f\"{tool.description}\")\n353:             lines.append(f\"Usage: `{tool.usage}`\")\n354:             lines.append(\"\")\n355:         return \"\\n\".join(lines)\n356: \n357:     def execute(self, name: str, input_str: str) -> str:\n358:         \"\"\"Execute a tool by name and return the result string.\"\"\"\n359:         tool = self._tools.get(name)\n360:         if tool is None:\n361:             available = \", \".join(self._tools.keys())\n362:             return f\"Error: Unknown tool '{name}'. Available tools: {available}\"\n363:         try:\n364:             result = tool.func(input_str.strip())\n365:             # Truncate very long outputs to prevent context overflow\n366:             if len(result) > 4000:\n367:                 result = result[:4000] + f\"\\n\\n... [output truncated, {len(result)} chars total]\"\n368:             return result\n369:         except Exception as e:\n370:             return f\"Error executing {name}: {type(e).__name__}: {str(e)}\"\n371: \n372:     # ------------------------------------------------------------------\n373:     # Built-in tool implementations\n374:     # ------------------------------------------------------------------\n375: \n376:     def _register_builtins(self):\n377:         self.register(ToolSpec(\n378:             name=\"list_files\",\n379:             description=\"List all code files in a directory (respects .git/node_modules/venv ignore rules).\",\n380:             usage=\"list_files <directory_path>  (e.g., list_files . or list_files src/)\",\n381:             func=self._tool_list_files,\n382:         ))\n383:         self.register(ToolSpec(\n384:             name=\"read_file\",\n385:             description=\"Read the contents of a file. Optionally specify line range with :start-end suffix.\",\n386:             usage=\"read_file <path>  or  read_file <path>:10-50\",\n387:             func=self._tool_read_file,\n388:         ))\n389:         self.register(ToolSpec(\n390:             name=\"search_code\",\n391:             description=\"Search for a regex pattern across all code files in the project. Returns matching lines.\",\n392:             usage=\"search_code <pattern>  (e.g., search_code eval\\\\(  or  search_code password)\",\n393:             func=self._tool_search_code,\n394:         ))\n395:         self.register(ToolSpec(\n396:             name=\"scan_code\",\n397:             description=\"Run static vulnerability pattern scanners on a specific file. Returns all findings.\",\n398:             usage=\"scan_code <file_path>  (e.g., scan_code app.py)\",\n399:             func=self._tool_scan_code,\n400:         ))\n401:         self.register(ToolSpec(\n402:             name=\"get_cwe_info\",\n403:             description=\"Look up detailed information about a CWE vulnerability class.\",\n404:             usage=\"get_cwe_info <cwe_id>  (e.g., get_cwe_info CWE-89)\",\n405:             func=self._tool_get_cwe_info,\n406:         ))\n407:         self.register(ToolSpec(\n408:             name=\"write_report\",\n409:             description=\"Write accumulated findings to a JSON or Markdown report file.\",\n410:             usage=\"write_report <format>  (format: json or markdown, e.g., write_report markdown)\",\n411:             func=self._tool_write_report,\n412:         ))\n413:         self.register(ToolSpec(\n414:             name=\"run_command\",\n415:             description=\"Execute a shell command (sandboxed to safe commands like git, python, grep, etc.).\",\n416:             usage=\"run_command <command>  (e.g., run_command git log -5 --oneline)\",\n417:             func=self._tool_run_command,\n418:         ))\n419:         self.register(ToolSpec(\n420:             name=\"fix_code\",\n421:             description=\"Generate a secure code fix suggestion for a given code snippet and vulnerability type.\",\n422:             usage=\"fix_code <cwe_id>|||<vulnerable_code_snippet>  (e.g., fix_code CWE-89|||query = f\\\"SELECT * FROM users WHERE id = '{uid}'\\\")\",\n423:             func=self._tool_fix_code,\n424:         ))\n425:         self.register(ToolSpec(\n426:             name=\"recon\",\n427:             description=\"Network reconnaissance & port scanner. Scans host for open TCP ports, banners, and services. Uses nmap if available, or fast socket scanner fallback.\",\n428:             usage=\"recon <host> [ports]  (e.g., recon 127.0.0.1 or recon example.com 80,443,8080 or recon 192.168.1.1 1-1024)\",\n429:             func=self._tool_recon,\n430:         ))\n431:         self.register(ToolSpec(\n432:             name=\"exploit_db\",\n433:             description=\"Query vulnerability database by CVE identifier or service keyword. Returns CVSS, attack vector, exploit prerequisites, and mitigations.\",\n434:             usage=\"exploit_db <cve_or_service_query>  (e.g., exploit_db CVE-2021-44228 or exploit_db apache or exploit_db ssh)\",\n435:             func=self._tool_exploit_db,\n436:         ))\n437:         self.register(ToolSpec(\n438:             name=\"generate_payload\",\n439:             description=\"Generate security audit verification payloads and test templates (SQLi, XSS, cmd injection, reverse shell syntax, SSTI, SSRF, LFI).\",\n440:             usage=\"generate_payload <type> <params>  (e.g., generate_payload sqli auth_bypass, generate_payload revshell 10.10.14.5:4444 bash, generate_payload xss reflected)\",\n441:             func=self._tool_generate_payload,\n442:         ))\n443:         self.register(ToolSpec(\n444:             name=\"web_attack\",\n445:             description=\"Web attack surface assessment: probes target URLs for exposed endpoints, sensitive files, and missing security headers.\",\n446:             usage=\"web_attack <url> [mode]  (e.g., web_attack http://localhost:8000 endpoints or web_attack https://target.com headers or web_attack http://127.0.0.1:5000 all)\",\n447:             func=self._tool_web_attack,\n448:         ))\n449:         self.register(ToolSpec(\n450:             name=\"post_exploit\",\n451:             description=\"Post-exploitation & privilege auditing advisor: provides enumeration checklists, persistence detection rules, and lateral movement audits for Linux/Windows/AD.\",\n452:             usage=\"post_exploit <os_type> [category]  (e.g., post_exploit linux privesc or post_exploit windows persistence or post_exploit ad lateral_movement)\",\n453:             func=self._tool_post_exploit,\n454:         ))\n455: \n456:     def _tool_list_files(self, directory: str) -> str:\n457:         target = os.path.abspath(os.path.join(self.working_dir, directory))\n458:         if not os.path.isdir(target):\n459:             return f\"Error: '{directory}' is not a valid directory.\"\n460: \n461:         files = []\n462:         code_extensions = {\n463:             \".py\", \".js\", \".ts\", \".jsx\", \".tsx\", \".go\", \".java\", \".php\",\n464:             \".c\", \".cpp\", \".h\", \".rs\", \".rb\", \".sql\", \".sh\", \".yaml\",\n465:             \".yml\", \".toml\", \".json\", \".env\", \".xml\", \".html\", \".css\",\n466:         }\n467:         for root, dirs, filenames in os.walk(target):\n468:             dirs[:] = [d for d in dirs if d not in IGNORE_DIRS]\n469:             for fname in sorted(filenames):\n470:                 ext = os.path.splitext(fname)[1].lower()\n471:                 if ext in code_extensions or fname in {\"Dockerfile\", \"Makefile\", \".gitignore\", \".env\"}:\n472:                     rel = os.path.relpath(os.path.join(root, fname), target)\n473:                     size = os.path.getsize(os.path.join(root, fname))\n474:                     files.append(f\"  {rel}  ({size} bytes)\")\n475: \n476:         if not files:\n477:             return f\"No code files found in '{directory}'.\"\n478:         return f\"Found {len(files)} files in '{directory}':\\n\" + \"\\n\".join(files)\n479: \n480:     def _tool_read_file(self, path_spec: str) -> str:\n481:         # Parse optional line range: path:start-end\n482:         start_line, end_line = None, None\n483:         if \":\" in path_spec and \"-\" in path_spec.rsplit(\":\", 1)[-1]:\n484:             parts = path_spec.rsplit(\":\", 1)\n485:             path_str = parts[0]\n486:             try:\n487:                 range_parts = parts[1].split(\"-\")\n488:                 start_line = int(range_parts[0])\n489:                 end_line = int(range_parts[1])\n490:             except (ValueError, IndexError):\n491:                 path_str = path_spec  # not a valid range, treat whole thing as path\n492:         else:\n493:             path_str = path_spec\n494: \n495:         full_path = os.path.abspath(os.path.join(self.working_dir, path_str.strip()))\n496:         if not os.path.isfile(full_path):\n497:             return f\"Error: File '{path_str}' not found.\"\n498: \n499:         try:\n500:             with open(full_path, \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n501:                 lines = f.readlines()\n502:         except Exception as e:\n503:             return f\"Error reading file: {e}\"\n504: \n505:         total = len(lines)\n506:         if start_line and end_line:\n507:             start_line = max(1, start_line)\n508:             end_line = min(total, end_line)\n509:             selected = lines[start_line - 1:end_line]\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
