on & Patch Quality Benchmark\n185: # =====================================================================\n186: REMEDIATION_CASES = [\n187:     {\n188:         \"id\": \"REM-TC1\",\n189:         \"name\": \"Remediation for Python eval() Dynamic Execution\",\n190:         \"code\": \"\"\"def calculate_formula(user_expr):\n191:     # Vulnerable calculation endpoint\n192:     return eval(user_expr)\"\"\"\n193:     },\n194:     {\n195:         \"id\": \"REM-TC2\",\n196:         \"name\": \"Remediation for Weak Cryptographic Hash (MD5 for Passwords)\",\n197:         \"code\": \"\"\"import hashlib\n198: \n199: def store_password(username, plain_password):\n200:     hashed = hashlib.md5(plain_password.encode()).hexdigest()\n201:     db.save_user(username, hashed)\"\"\"\n202:     }\n203: ]\n204: \n205: \n206: def load_model():\n207:     print(\"=\" * 80)\n208:     print(f\"[*] Loading Fluxnat Coder 3B from Hub / Cache: {MODEL_ID}\")\n209:     print(f\"[*] PyTorch Version: {torch.__version__} | CUDA: {torch.cuda.is_available()}\")\n210:     if torch.cuda.is_available():\n211:         print(f\"[*] GPU: {torch.cuda.get_device_name(0)}\")\n212:     print(\"=\" * 80)\n213: \n214:     tokenizer = AutoTokenizer.from_pretrained(MODEL_ID, trust_remote_code=True)\n215:     if tokenizer.pad_token is None:\n216:         tokenizer.pad_token = tokenizer.eos_token\n217: \n218:     model = AutoModelForCausalLM.from_pretrained(\n219:         MODEL_ID,\n220:         torch_dtype=torch.float16 if torch.cuda.is_available() else torch.float32,\n221:         device_map=\"auto\" if torch.cuda.is_available() else None,\n222:         trust_remote_code=True,\n223:         low_cpu_mem_usage=True\n224:     )\n225:     model.eval()\n226:     return tokenizer, model\n227: \n228: \n229: def query_model(tokenizer, model, user_prompt: str, max_tokens: int = 350) -> str:\n230:     messages = [\n231:         {\"role\": \"system\", \"content\": SYSTEM_PROMPT},\n232:         {\"role\": \"user\", \"content\": user_prompt}\n233:     ]\n234:     text = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)\n235:     inputs = tokenizer(text, return_tensors=\"pt\")\n236:     inputs = {k: v.to(model.device) for k, v in inputs.items()}\n237: \n238:     with torch.no_grad():\n239:         output_tokens = model.generate(\n240:             **inputs,\n241:             max_new_tokens=max_tokens,\n242:             temperature=0.1,\n243:             top_p=0.9,\n244:             repetition_penalty=1.05,\n245:             do_sample=False,\n246:             pad_token_id=tokenizer.pad_token_id,\n247:             eos_token_id=tokenizer.eos_token_id\n248:         )\n249: \n250:     return tokenizer.decode(output_tokens[0][inputs[\"input_ids\"].shape[1]:], skip_special_tokens=True).strip()\n251: \n252: \n253: def run_benchmarks():\n254:     tokenizer, model = load_model()\n255:     print(\"\\n[+] Model successfully initialized for benchmarking.\\n\")\n256: \n257:     overall_results = {\n258:         \"cwe_detection\": [],\n259:         \"false_positive\": [],\n260:         \"remediation\": []\n261:     }\n262: \n263:     # =================================================================\n264:     # RUN BENCHMARK 1: CWE Detection & Classification\n265:     # =================================================================\n266:     print(\"\\n\" + \"=\" * 80)\n267:     print(\" BENCHMARK SUITE 1: Multi-Language CWE Vulnerability Detection & Identification\")\n268:     print(\"=\" * 80)\n269:     print(f\"{'ID':<9} | {'Lang':<8} | {'Test Scenario':<30} | {'Expected':<9} | {'Result':<10} | {'Status'}\")\n270:     print(\"-\" * 80)\n271: \n272:     for tc in CWE_DETECTION_CASES:\n273:         prompt = (\n274:             f\"Perform a rigorous cybersecurity vulnerability assessment of this {tc['lang']} code snippet.\\n\"\n275:             f\"Determine if it is VULNERABLE or BENIGN.\\n\"\n276:             f\"If vulnerable, state the exact CWE identifier (e.g., CWE-89, CWE-78) and provide brief reasoning.\\n\\n\"\n277:             f\"```{tc['lang'].lower()}\\n{tc['code']}\\n```\"\n278:         )\n279:         t0 = time.time()\n280:         resp = query_model(tokenizer, model, prompt, max_tokens=250)\n281:         dur = time.time() - t0\n282: \n283:         resp_lower = resp.lower()\n284:         is_vuln_detected = (\"vulnerable\" in resp_lower or \"security flaw\" in resp_lower or \"critical\" in resp_lower) and (\"not vulnerable\" not in resp_lower and \"benign\" not in resp_lower)\n285:         expected_cwe_num = tc[\"expected_cwe\"].split(\"-\")[-1]\n286:         cwe_matched = (tc[\"expected_cwe\"].lower() in resp_lower) or (f\"cwe {expected_cwe_num}\" in resp_lower) or (f\"cwe-{expected_cwe_num}\" in resp_lower)\n287: \n288:         passed = is_vuln_detected and cwe_matched\n289:         status = \"PASSED [OK]\" if passed else \"FAILED [X]\"\n290: \n291:         cwe_found_str = tc[\"expected_cwe\"] if cwe_matched else (\"DETECTED\" if is_vuln_detected else \"MISSED\")\n292: \n293:         print(f\"{tc['id']:<9} | {tc['lang'][:8]:<8} | {tc['name'][:30]:<30} | {tc['expected_cwe']:<9} | {cwe_found_str:<10} | {status} ({dur:.1f}s)\")\n294:         overall_results[\"cwe_detection\"].append({\n295:             \"id\": tc[\"id\"],\n296:             \"name\": tc[\"name\"],\n297:             \"passed\": passed,\n298:             \"response\": resp[:250]\n299:         })\n300: \n301:     # =================================================================\n302:     # RUN BENCHMARK 2: False Positive Resistance (Benign Code)\n303:     # =================================================================\n304:     print(\"\\n\" + \"=\" * 80)\n305:     print(\" BENCHMARK SUITE 2: False Positive Resistance Benchmark (Clean & Safe Code)\")\n306:     print(\"=\" * 80)\n307:     print(f\"{'ID':<9} | {'Lang':<8} | {'Scenario':<35} | {'Classification':<15} | {'Status'}\")\n308:     print(\"-\" * 80)\n309: \n310:     for tc in BENIGN_CODE_CASES:\n311:         prompt = (\n312:             f\"Analyze this {tc['lang']} code snippet for security vulnerabilities.\\n\"\n313:             f\"Classify it strictly as either VULNERABLE or BENIGN/SECURE. Explain your reasoning.\\n\\n\"\n314:             f\"```{tc['lang'].lower()}\\n{tc['code']}\\n```\"\n315:         )\n316:         t0 = time.time()\n317:         resp = query_model(tokenizer, model, prompt, max_tokens=250)\n318:         dur = time.time() - t0\n319: \n320:         resp_lower = resp.lower()\n321:         # Benign is passed if model recognizes it as benign/secure and does not report a false positive vulnerability\n322:         is_classified_secure = (\n323:             (\"benign\" in resp_lower or \"secure\" in resp_lower or \"safe\" in resp_lower or \"not vulnerable\" in resp_lower or \"no vulnerability\" in resp_lower)\n324:             and (\"is vulnerable\" not in resp_lower and \"critical\" not in resp_lower)\n325:         )\n326: \n327:         passed = is_classified_secure\n328:         status = \"PASSED [OK]\" if passed else \"FAILED [X]\"\n329:         cls_str = \"BENIGN / SAFE\" if is_classified_secure else \"FALSE POSITIVE\"\n330: \n331:         print(f\"{tc['id']:<9} | {tc['lang'][:8]:<8} | {tc['name'][:35]:<35} | {cls_str:<15} | {status} ({dur:.1f}s)\")\n332:         overall_results[\"false_positive\"].append({\n333:             \"id\": tc[\"id\"],\n334:             \"name\": tc[\"name\"],\n335:             \"passed\": passed,\n336:             \"response\": resp[:250]\n337:         })\n338: \n339:     # =================================================================\n340:     # RUN BENCHMARK 3: Remediation & Patch Generation\n341:     # =================================================================\n342:     print(\"\\n\" + \"=\" * 80)\n343:     print(\" BENCHMARK SUITE 3: Secure Code Remediation & Patch Generation Benchmark\")\n344:     print(\"=\" * 80)\n345: \n346:     for tc in REMEDIATION_CASES:\n347:         prompt = (\n348:             f\"Perform a security remediation on the following vulnerable code snippet.\\n\"\n349:             f\"1. Name the vulnerability and CWE ID.\\n\"\n350:             f\"2. Provide a production-ready, secure refactored code replacement.\\n\"\n351:             f\"3. Explain why the replacement eliminates the risk.\\n\\n\"\n352:             f\"```python\\n{tc['code']}\\n```\"\n353:         )\n354:         print(f\"\\n[*] Evaluating: {tc['name']}\")\n355:         t0 = time.time()\n356:         resp = query_model(tokenizer, model, prompt, max_tokens=400)\n357:         dur = time.time() - t0\n358: \n359:         has_code_block = \"```\" in resp\n360:         has_explanation = len(resp) > 100\n361:         passed = has_code_block and has_explanation\n362:         status = \"PASSED [OK]\" if passed else \"FAILED [X]\"\n363: \n364:         print(f\"Result: {status} (Completed in {dur:.1f}s)\")\n365:         print(\"-\" * 60)\n366:         print(resp)\n367:         print(\"-\" * 60)\n368:         overall_results[\"remediation\"].append({\n369:             \"id\": tc[\"id\"],\n370:             \"name\": tc[\"name\"],\n371:             \"passed\": passed,\n372:             \"response\": resp\n373:         })\n374: \n375:     # =================================================================\n376:     # SCORECARD & SUMMARY METRICS\n377:     # =================================================================\n378:     cwe_total = len(overall_results[\"cwe_detection\"])\n379:     cwe_passed = sum(1 for r in overall_results[\"cwe_detection\"] if r[\"passed\"])\n380:     cwe_acc = (cwe_passed / cwe_total) * 100\n381: \n382:     fp_total = len(overall_results[\"false_positive\"])\n383:     fp_passed = sum(1 for r in overall_results[\"false_positive\"] if r[\"passed\"])\n384:     fp_acc = (fp_passed / fp_total) * 100\n385: \n386:     rem_total = len(overall_results[\"remediation\"])\n387:     rem_passed = sum(1 for r in overall_results[\"remediation\"] if r[\"passed\"])\n388:     r