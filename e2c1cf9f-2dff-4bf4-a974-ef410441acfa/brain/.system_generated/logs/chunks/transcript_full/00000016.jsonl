ss)\n# - warmup_steps=3: Gentle warmup for adapter weights\ntraining_args = TrainingArguments(\n    output_dir=OUTPUT_DIR,\n    per_device_train_batch_size=2,\n    gradient_accumulation_steps=4,\n    warmup_steps=3,\n    max_steps=25,             # Calibrated: 2 epochs instead of 5, finishes in ~75-90s on T4\n    learning_rate=1e-4,       # Calibrated: 1e-4 (down from 2e-4) to prevent memorization\n    fp16=not is_bfloat16_supported(),\n    bf16=is_bfloat16_supported(),\n    logging_steps=2,\n    optim=\"adamw_8bit\",\n    weight_decay=0.01,\n    lr_scheduler_type=\"cosine\",\n    seed=3407,\n)\n\ntrainer = SFTTrainer(\n    model=model,\n    tokenizer=tokenizer,\n    train_dataset=train_dataset,\n    dataset_text_field=\"text\",\n    max_seq_length=MAX_SEQ_LENGTH,\n    dataset_num_proc=2,\n    packing=False,\n    args=training_args,\n)\n\nprint(\"[+] Training Fluxnat Coder 3B (Calibrated 2 Epochs, Target Loss ~0.60 - 0.80)...\")\ntrainer.train()\nprint(\"[✓] Calibrated training completed successfully without overfitting!\")\n\"\"\"\nnb['cells'][10]['source'] = [line + '\\n' for line in cell_10_code.strip().split('\\n')]\nnb['cells'][10]['metadata']['id'] = 'bBtUZIG4wjco'\n\nwith open(nb_path, 'w', encoding='utf-8') as f:\n    json.dump(nb, f, indent=1, ensure_ascii=False)\n\nprint(f\"[✓] Successfully updated {nb_path} with calibrated parameters!\")\n","Description":"Update cells 6, 8, and 10 in Fluxnat_Coder_3B_Training.ipynb","Overwrite":true,"TargetFile":"C:\\Users\\k4ran\\.gemini\\antigravity\\brain\\e2c1cf9f-2dff-4bf4-a974-ef410441acfa\\scratch\\update_notebook.py","toolAction":"Creating notebook update script","toolSummary":"Write update_notebook.py"}}]}
