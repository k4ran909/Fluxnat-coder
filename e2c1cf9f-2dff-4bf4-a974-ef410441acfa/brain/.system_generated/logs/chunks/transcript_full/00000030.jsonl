{"step_index":1340,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-23T08:02:00Z","content":"Created At: 2026-09-23T13:32:00+05:30\nCompleted At: 2026-09-23T13:32:00+05:30\nFile Path: `file:///c:/Users/k4ran/OneDrive/Desktop/smartAGENT/prepare_datasets.py`\nTotal Lines: 197\nTotal Bytes: 7908\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: Dataset Preparation Pipeline for Fluxnat Coder 3B.\n4: Downloads, validates, cleans, and standardizes cybersecurity datasets\n5: into standard chat format with the custom Fluxnat Coder 3B identity.\n6: \"\"\"\n7: \n8: import os\n9: import json\n10: import random\n11: import yaml\n12: from pathlib import Path\n13: from typing import List, Dict, Any, Optional\n14: \n15: try:\n16:     from datasets import load_dataset\n17: except ImportError:\n18:     load_dataset = None\n19: \n20: \n21: DEFAULT_SYSTEM_PROMPT = (\n22:     \"You are Fluxnat Coder 3B, an elite AI cybersecurity and secure coding intelligence model created by Fluxnat. \"\n23:     \"Your mission is to perform rigorous source code vulnerability auditing, identify CWE and OWASP Top 10 security flaws, \"\n24:     \"explain attack surfaces and root causes using detailed step-by-step reasoning, and provide production-ready secure remediations.\"\n25: )\n26: \n27: \n28: def load_config(config_path: str = \"config/training_config.yaml\") -> Dict[str, Any]:\n29:     \"\"\"Load configuration yaml file.\"\"\"\n30:     if os.path.exists(config_path):\n31:         with open(config_path, \"r\", encoding=\"utf-8\") as f:\n32:             return yaml.safe_load(f)\n33:     return {}\n34: \n35: \n36: def format_qa_to_chat(instruction: str, response: str, system_prompt: str = DEFAULT_SYSTEM_PROMPT) -> Dict[str, Any]:\n37:     \"\"\"Format single instruction-response pair into chat message structure.\"\"\"\n38:     return {\n39:         \"messages\": [\n40:             {\"role\": \"system\", \"content\": system_prompt},\n41:             {\"role\": \"user\", \"content\": instruction.strip()},\n42:             {\"role\": \"assistant\", \"content\": response.strip()}\n43:         ]\n44:     }\n45: \n46: \n47: def load_local_cot_data(cot_path: str, system_prompt: str) -> List[Dict[str, Any]]:\n48:     \"\"\"Load local curated chain-of-thought security dataset.\"\"\"\n49:     records = []\n50:     if not os.path.exists(cot_path):\n51:         print(f\"[!] Warning: Local CoT file not found at {cot_path}\")\n52:         return records\n53: \n54:     with open(cot_path, \"r\", encoding=\"utf-8\") as f:\n55:         for line in f:\n56:             line = line.strip()\n57:             if not line:\n58:                 continue\n59:             try:\n60:                 item = json.loads(line)\n61:                 if \"messages\" in item:\n62:                     # Update system prompt if needed\n63:                     if item[\"messages\"] and item[\"messages\"][0][\"role\"] == \"system\":\n64:                         item[\"messages\"][0][\"content\"] = system_prompt\n65:                     records.append(item)\n66:             except Exception as e:\n67:                 print(f\"[!] Error parsing line in {cot_path}: {e}\")\n68:     print(f\"[+] Loaded {len(records)} local CoT samples from {cot_path}\")\n69:     return records\n70: \n71: \n72: def download_and_format_hf_datasets(config: Dict[str, Any], system_prompt: str) -> List[Dict[str, Any]]:\n73:     \"\"\"Download cybersecurity datasets from Hugging Face and format them.\"\"\"\n74:     if load_dataset is None:\n75:         print(\"[!] 'datasets' library is not installed. Skipping Hugging Face download.\")\n76:         return []\n77: \n78:     hf_token = os.getenv(\"HF_TOKEN\")\n79:     dataset_sources = config.get(\"datasets\", {}).get(\"sources\", [])\n80:     collected_samples: List[Dict[str, Any]] = []\n81: \n82:     for src in dataset_sources:\n83:         src_name = src.get(\"name\")\n84:         limit = src.get(\"sample_limit\", 10000)\n85: \n86:         if src_name == \"local_cot\":\n87:             continue\n88: \n89:         print(f\"[*] Fetching Hugging Face dataset: {src_name} (max: {limit})...\")\n90:         try:\n91:             ds = load_dataset(src_name, split=\"train\", token=hf_token)\n92:             count = 0\n93:             for item in ds:\n94:                 if count >= limit:\n95:                     break\n96: \n97:                 instruction = \"\"\n98:                 response = \"\"\n99: \n100:                 # Handle various common schema shapes\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
