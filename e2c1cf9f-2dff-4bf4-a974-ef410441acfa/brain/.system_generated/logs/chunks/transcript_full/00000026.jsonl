{"step_index":1192,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-22T11:33:14Z","content":"Created At: 2026-09-22T17:03:14+05:30\nCompleted At: 2026-09-22T17:03:15+05:30\nFile Path: `file:///c:/Users/k4ran/OneDrive/Desktop/smartAGENT/smartagent/config.py`\nTotal Lines: 54\nTotal Bytes: 1786\nShowing lines 1 to 54\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: SmartAGENT Configuration Management.\n3: \"\"\"\n4: \n5: import os\n6: from pathlib import Path\n7: from pydantic import BaseModel, Field\n8: from typing import List, Optional\n9: \n10: \n11: class ScannerConfig(BaseModel):\n12:     # Model configuration\n13:     model_id: str = Field(\n14:         default=\"k4ran909/Fluxnat-Coder-3B\",\n15:         description=\"Model ID on Hugging Face Hub or local path to merged weights\"\n16:     )\n17:     fallback_model_id: str = Field(\n18:         default=\"k4ran909/Fluxnat-Coder-3B\",\n19:         description=\"Model checkpoint ID on Hugging Face\"\n20:     )\n21:     load_in_4bit: bool = Field(\n22:         default=True,\n23:         description=\"Use 4-bit quantization for minimal VRAM usage\"\n24:     )\n25: \n26:     # Scanning options\n27:     target_extensions: List[str] = Field(\n28:         default=[\".py\", \".js\", \".ts\", \".jsx\", \".tsx\", \".go\", \".java\", \".php\", \".c\", \".cpp\", \".rs\", \".sql\", \".env\", \"Dockerfile\"],\n29:         description=\"File extensions to include in scan\"\n30:     )\n31:     ignored_directories: List[str] = Field(\n32:         default=[\".git\", \"node_modules\", \"venv\", \".venv\", \"__pycache__\", \"dist\", \"build\", \".idea\", \".vscode\", \"outputs\"],\n33:         description=\"Directories to exclude from scanning\"\n34:     )\n35:     max_file_size_kb: int = Field(\n36:         default=1024,\n37:         description=\"Maximum file size in KB to parse\"\n38:     )\n39: \n40:     # Reporting\n41:     output_format: str = Field(\n42:         default=\"rich\",\n43:         description=\"Output format: rich, json, markdown, html\"\n44:     )\n45: \n46: \n47: def get_default_config() -> ScannerConfig:\n48:     \"\"\"Retrieve scanner configuration from environment or defaults.\"\"\"\n49:     # Check if local merged model exists\n50:     local_merged = Path(\"./outputs/Fluxnat-Coder-3B-Merged\")\n51:     model_path = str(local_merged) if local_merged.exists() else os.getenv(\"SMARTAGENT_MODEL\", \"fluxnat/Fluxnat-Coder-3B\")\n52: \n53:     return ScannerConfig(model_id=model_path)\n54: \nThe above content shows the entire, complete file contents of the requested file.\n"}
