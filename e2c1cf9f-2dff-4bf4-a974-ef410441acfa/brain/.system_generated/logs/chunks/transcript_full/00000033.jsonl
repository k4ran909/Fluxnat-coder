xt, call_next):\r\n127:         result = await call_next(context)\r\n128:         if context.message.name != INJECTED_TOOL_NAME:\r\n129:             return result\r\n130:         if self.proxy_client.is_connected():\r\n131:             return result\r\n132:         # if the tool call was for open_colab_browser_connection and there is no existing connection, try to await full connection\r\n133:         await context.fastmcp_context.report_progress(\r\n134:             progress=1, total=3, message=\"The user is not connected to the Colab UI\"\r\n135:         )\r\n136:         await context.fastmcp_context.report_progress(\r\n137:             progress=2,\r\n138:             total=3,\r\n139:             message=\"Waiting for user to connect in Colab - will wait for 60s\",\r\n140:         )\r\n141:         await self.proxy_client.await_proxy_connection()\r\n142:         if self.proxy_client.is_connected():\r\n143:             await context.fastmcp_context.report_progress(\r\n144:                 progress=3, total=3, message=\"The Colab UI is successfully connected!\"\r\n145:             )\r\n146:             return ToolResult(\r\n147:                 content=[TextContent(type=\"text\", text=\"true\")],\r\n148:                 structured_content={\"result\": True},\r\n149:             )\r\n150:         else:\r\n151:             await context.fastmcp_context.report_progress(\r\n152:                 progress=3,\r\n153:                 total=3,\r\n154:                 message=\"Timeout while waiting for the user to connect.\",\r\n155:             )\r\n156:             return ToolResult(\r\n157:                 content=[TextContent(type=\"text\", text=\"false\")],\r\n158:                 structured_content={\"result\": False},\r\n159:             )\r\n160: \r\n161: \r\n162: async def check_session_proxy_tool_fn(ctx: Context = CurrentContext()) -> bool:\r\n163:     fe_connected = ctx.get_state(FE_CONNECTED_KEY)\r\n164:     token = ctx.get_state(PROXY_TOKEN_KEY)\r\n165:     port = ctx.get_state(PROXY_PORT_KEY)\r\n166:     if fe_connected:\r\n167:         return True\r\n168:     webbrowser.open_new(\r\n169:         f\"{COLAB}{SCRATCH_PATH}#mcpProxyToken={token}&mcpProxyPort={port}\"\r\n170:     )\r\n171:     return False\r\n172: \r\n173: \r\n174: check_session_proxy_tool = Tool.from_function(\r\n175:     fn=check_session_proxy_tool_fn,\r\n176:     name=INJECTED_TOOL_NAME,\r\n177:     description=\"Opens a connection to a Google Colab browser session and unlocks notebook editing tools. Returns a boolean representing whether the connection attempt succeeded\",\r\n178: )\r\n179: \r\n180: \r\n181: class ColabSessionProxy:\r\n182:     def __init__(self):\r\n183:         self._exit_stack = AsyncExitStack()\r\n184:         self.proxy_server: FastMCPProxy | None = None\r\n185:         # list order matters, see: https://gofastmcp.com/servers/middleware#multiple-middleware\r\n186:         self.middleware: list[Middleware] = []\r\n187:         self.wss: ColabWebSocketServer | None = None\r\n188: \r\n189:     async def start_proxy_server(self):\r\n190:         self.wss = await self._exit_stack.enter_async_context(ColabWebSocketServer())\r\n191:         proxy_client = await self._exit_stack.enter_async_context(\r\n192:             ColabProxyClient(self.wss)\r\n193:         )\r\n194:         self.proxy_server = FastMCPProxy(\r\n195:             client_factory=proxy_client.client_factory,\r\n196:             instructions=\"Connects to a user's Google Colab session in a browser and allows for interactions with their Google Colab notebook\",\r\n197:         )\r\n198:         # ColabProxyMiddleware must be first because it sets the fe_connected state\r\n199:         self.middleware.append(ColabProxyMiddleware(proxy_client))\r\n200:         self.middleware.append(\r\n201:             ToolInjectionMiddleware(tools=[check_session_proxy_tool])\r\n202:         )\r\n203: \r\n204:     async def cleanup(self):\r\n205:         await self._exit_stack.aclose()\r\n206: