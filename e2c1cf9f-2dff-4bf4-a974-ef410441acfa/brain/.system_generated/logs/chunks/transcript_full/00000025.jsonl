{"step_index":1187,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-22T11:33:05Z","content":"Created At: 2026-09-22T17:03:05+05:30\nCompleted At: 2026-09-22T17:03:06+05:30\nFile Path: `file:///c:/Users/k4ran/OneDrive/Desktop/smartAGENT/smartagent/cli.py`\nTotal Lines: 174\nTotal Bytes: 6745\nShowing lines 1 to 174\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: SmartAGENT CLI Entry Point.\n3: Provides commands to scan projects for vulnerabilities and launch Fluxnat Coder 3B training.\n4: \"\"\"\n5: \n6: import os\n7: import sys\n8: from pathlib import Path\n9: from typing import Optional, List\n10: import typer\n11: from rich.console import Console\n12: from rich.panel import Panel\n13: \n14: # Ensure UTF-8 output on Windows consoles\n15: if sys.platform == \"win32\":\n16:     try:\n17:         sys.stdout.reconfigure(encoding=\"utf-8\")\n18:         sys.stderr.reconfigure(encoding=\"utf-8\")\n19:     except Exception:\n20:         pass\n21: \n22: from smartagent.config import get_default_config\n23: from smartagent.scanners import ALL_SCANNERS, Finding\n24: from smartagent.reporting import (\n25:     print_rich_report,\n26:     export_json_report,\n27:     export_markdown_report,\n28: )\n29: \n30: app = typer.Typer(\n31:     name=\"smartagent\",\n32:     help=\"SmartAGENT - AI-Powered Cybersecurity Vulnerability Scanner & Fluxnat Coder 3B Suite\",\n33:     add_completion=False,\n34: )\n35: console = Console(legacy_windows=False)\n36: \n37: \n38: @app.command(\"scan\")\n39: def scan_project(\n40:     target_dir: str = typer.Argument(\".\", help=\"Directory or file path to scan\"),\n41:     ai_verify: bool = typer.Option(False, \"--ai\", \"-a\", help=\"Use Fluxnat Coder 3B for false-positive reduction & fix generation\"),\n42:     model_id: Optional[str] = typer.Option(None, \"--model\", \"-m\", help=\"Hugging Face model ID or path to merged model\"),\n43:     json_out: Optional[str] = typer.Option(None, \"--json\", \"-j\", help=\"Path to write JSON report\"),\n44:     md_out: Optional[str] = typer.Option(None, \"--md\", help=\"Path to write Markdown report\"),\n45: ):\n46:     \"\"\"\n47:     Perform an automated vulnerability audit on a project codebase.\n48:     \"\"\"\n49:     config = get_default_config()\n50:     target_path = Path(target_dir).resolve()\n51: \n52:     if not target_path.exists():\n53:         console.print(f\"[bold red]Error:[/bold red] Target path does not exist: {target_path}\")\n54:         raise typer.Exit(code=1)\n55: \n56:     console.print(Panel(\n57:         f\"[bold cyan]SmartAGENT Vulnerability Audit[/bold cyan]\\n\"\n58:         f\"Scanning: [white]{target_path}[/white]\\n\"\n59:         f\"Scanners Active: [green]{len(ALL_SCANNERS)}[/green] (Secrets, Code Patterns, Dependencies, Configs)\\n\"\n60:         f\"AI Verification: [yellow]{'Enabled (Fluxnat Coder 3B)' if ai_verify else 'Disabled (Static Pass Only)'}[/yellow]\",\n61:         title=\"⚡ Initializing Audit\",\n62:         expand=False\n63:     ))\n64: \n65:     all_findings: List[Finding] = []\n66: \n67:     # File traversal\n68:     files_to_scan: List[Path] = []\n69:     if target_path.is_file():\n70:         files_to_scan.append(target_path)\n71:     else:\n72:         for root, dirs, files in os.walk(target_path):\n73:             # Prune ignored directories\n74:             dirs[:] = [d for d in dirs if d not in config.ignored_directories]\n75:             for file in files:\n76:                 fpath = Path(root) / file\n77:                 if any(file.endswith(ext) or file == ext for ext in config.target_extensions):\n78:                     # Check file size\n79:                     try:\n80:                         if fpath.stat().st_size <= config.max_file_size_kb * 1024:\n81:                             files_to_scan.append(fpath)\n82:                     except Exception:\n83:                         pass\n84: \n85:     console.print(f\"[*] Analyzing [cyan]{len(files_to_scan)}[/cyan] matching project files...\")\n86: \n87:     with console.status(\"[bold green]Running static analysis rules...\") as status:\n88:         for fpath in files_to_scan:\n89:             try:\n90:                 with open(fpath, \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n91:                     content = f.read()\n92: \n93:                 rel_path = str(fpath.relative_to(target_path)) if target_path.is_dir() else str(fpath.name)\n94:                 for scanner in ALL_SCANNERS:\n95:                     findings = scanner.scan_file(rel_path, content)\n96:                     all_findings.extend(findings)\n97:             except Exception as e:\n98:                 pass\n99: \n100:     console.print(f\"[✓] Static analysis complete. Identified [bold red]{len(all_findings)}[/bold red] potential findings.\")\n101: \n102:     # AI Verification Stage\n103:     if ai_verify and all_findings:\n104:         console.print(\"[*] Engaging [bold cyan]Fluxnat Coder 3B[/bold cyan] for Chain-of-Thought verification...\")\n105:         try:\n106:             from smartagent.ai.judge import AIJudge\n107:             effective_model = model_id or config.model_id\n108:             judge = AIJudge(model_id=effective_model)\n109:             all_findings = judge.verify_findings(all_findings)\n110:             console.print(\"[✓] AI reasoning pass complete.\")\n111:         except Exception as e:\n112:             console.print(f\"[!] AI Verification pass skipped: {e}\")\n113: \n114:     # Output Reports\n115:     print_rich_report(all_findings, str(target_path))\n116: \n117:     if json_out:\n118:         export_json_report(all_findings, str(target_path), json_out)\n119: \n120:     if md_out:\n121:         export_markdown_report(all_findings, str(target_path), md_out)\n122: \n123: \n124: @app.command(\"train\")\n125: def train_model():\n126:     \"\"\"\n127:     Launch local training or view Google Colab training instructions for Fluxnat Coder 3B.\n128:     \"\"\"\n129:     console.print(Panel(\n130:         \"[bold cyan]Fluxnat Coder 3B Training Suite[/bold cyan]\\n\\n\"\n131:         \"1. [bold green]Google Colab (Recommended):[/bold green]\\n\"\n132:         \"   Upload `Fluxnat_Coder_3B_Training.ipynb` to Google Colab and run with a free T4 GPU (16GB VRAM).\\n\\n\"\n133:         \"2. [bold yellow]Local Execution:[/bold yellow]\\n\"\n134:         \"   Run: `python train.py`\\n\\n\"\n135:         \"3. [bold white]Configuration:[/bold white]\\n\"\n136:         \"   Adjust parameters in `config/training_config.yaml`\",\n137:         title=\"🚀 Train Fluxnat Coder 3B\",\n138:         expand=False\n139:     ))\n140: \n141: \n142: @app.command(\"info\")\n143: def system_info():\n144:     \"\"\"\n145:     Display SmartAGENT environment and system status.\n146:     \"\"\"\n147:     try:\n148:         import torch\n149:         has_cuda = torch.cuda.is_available()\n150:         device_name = torch.cuda.get_device_name(0) if has_cuda else \"None (CPU)\"\n151:         vram = f\"{torch.cuda.get_device_properties(0).total_memory / (1024**3):.1f} GB\" if has_cuda else \"N/A\"\n152:         torch_status = f\"Installed (v{torch.__version__})\"\n153:     except ImportError:\n154:         has_cuda = False\n155:         device_name = \"N/A\"\n156:         vram = \"N/A\"\n157:         torch_status = \"Not Installed (Install via `pip install torch` for AI reasoning)\"\n158: \n159:     console.print(Panel(\n160:         f\"[bold white]SmartAGENT Version:[/bold white] 0.1.0\\n\"\n161:         f\"[bold white]Target Model:[/bold white] fluxnat/Fluxnat-Coder-3B\\n\"\n162:         f\"[bold white]PyTorch Status:[/bold white] {torch_status}\\n\"\n163:         f\"[bold white]CUDA Available:[/bold white] {'[green]Yes[/green]' if has_cuda else '[yellow]No[/yellow]'}\\n\"\n164:         f\"[bold white]GPU Device:[/bold white] {device_name}\\n\"\n165:         f\"[bold white]VRAM:[/bold white] {vram}\\n\"\n166:         f\"[bold white]Active Scanners:[/bold white] {', '.join(s.name for s in ALL_SCANNERS)}\",\n167:         title=\"[bold cyan]ℹ️ SmartAGENT System Status[/bold cyan]\",\n168:         expand=False\n169:     ))\n170: \n171: \n172: if __name__ == \"__main__\":\n173:     app()\n174: \nThe above content shows the entire, complete file contents of the requested file.\n"}
{"step_index":1189,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-22T11:33:12Z","content":"Created At: 2026-09-22T17:03:12+05:30\nCompleted At: 2026-09-22T17:03:13+05:30\nFile Path: `file:///c:/Users/k4ran/OneDrive/Desktop/smartAGENT/smartagent/ai/model.py`\nTotal Lines: 90\nTotal Bytes: 3257\nShowing lines 1 to 90\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: Model Loader and Inference Engine for Fluxnat Coder 3B.\n3: \"\"\"\n4: \n5: import os\n6: from pathlib import Path\n7: from typing import Optional, Tuple\n8: import torch\n9: from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig\n10: \n11: \n12: class ModelManager:\n13:     _instance: Optional[\"ModelManager\"] = None\n14:     _model = None\n15:     _tokenizer = None\n16: \n17:     def __init__(self, model_id: str = \"k4ran909/Fluxnat-Coder-3B\", load_in_4bit: bool = True):\n18:         self.model_id = model_id\n19:         self.load_in_4bit = load_in_4bit\n20:         self.device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n21: \n22:     @classmethod\n23:     def get_instance(cls, model_id: str = \"k4ran909/Fluxnat-Coder-3B\", load_in_4bit: bool = True) -> \"ModelManager\":\n24:         if cls._instance is None:\n25:             cls._instance = cls(model_id, load_in_4bit)\n26:         return cls._instance\n27: \n28:     def load(self) -> Tuple[Any, Any]:\n29:         if self._model is not None and self._tokenizer is not None:\n30:             return self._model, self._tokenizer\n31: \n32:         target = self.model_id\n33:         local_path = Path(target)\n34:         if not local_path.exists():\n35:             # Check local output paths\n36:             candidates = [\n37:                 Path(\"./outputs/Fluxnat-Coder-3B-Merged\"),\n38:                 Path(\"./outputs/Fluxnat-Coder-3B\"),\n39:             ]\n40:             for cand in candidates:\n41:                 if cand.exists():\n42:                     target = str(cand)\n43:                     break\n44: \n45:         print(f\"[*] Initializing Fluxnat Coder 3B from: {target} on {self.device}...\")\n46: \n47:         self._tokenizer = AutoTokenizer.from_pretrained(target, trust_remote_code=True)\n48: \n49:         if self._tokenizer.pad_token is None:\n50:             self._tokenizer.pad_token = self._tokenizer.eos_token\n51: \n52:         if self.device == \"cuda\" and self.load_in_4bit:\n53:             bnb_config = BitsAndBytesConfig(\n54:                 load_in_4bit=True,\n55:                 bnb_4bit_quant_type=\"nf4\",\n56:                 bnb_4bit_compute_dtype=torch.float16,\n57:             )\n58:             self._model = AutoModelForCausalLM.from_pretrained(\n59:                 target,\n60:                 quantization_config=bnb_config,\n61:                 device_map=\"auto\",\n62:                 trust_remote_code=True,\n63:             )\n64:         else:\n65:             self._model = AutoModelForCausalLM.from_pretrained(\n66:                 target,\n67:                 torch_dtype=torch.float16 if self.device == \"cuda\" else torch.float32,\n68:                 device_map=\"auto\" if self.device == \"cuda\" else None,\n69:                 trust_remote_code=True,\n70:             )\n71: \n72:         return self._model, self._tokenizer\n73: \n74:     def generate(self, messages: list, max_tokens: int = 512, temperature: float = 0.2) -> str:\n75:         model, tokenizer = self.load()\n76:         text = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)\n77:         inputs = tokenizer(text, return_tensors=\"pt\").to(model.device)\n78: \n79:         with torch.no_grad():\n80:             outputs = model.generate(\n81:                 **inputs,\n82:                 max_new_tokens=max_tokens,\n83:                 temperature=temperature,\n84:                 top_p=0.95,\n85:                 repetition_penalty=1.05,\n86:                 do_sample=temperature > 0.0,\n87:             )\n88: \n89:         return tokenizer.decode(outputs[0][inputs.input_ids.shape[1]:], skip_special_tokens=True).strip()\n90: \nThe above content shows the entire, complete file contents of the requested file.\n"}
{"step_index":1190,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-22T11:33:13Z","content":"Created At: 2026-09-22T17:03:13+05:30\nCompleted At: 2026-09-22T17:03:14+05:30\nFile Path: `file:///c:/Users/k4ran/OneDrive/Desktop/smartAGENT/smartagent/ai/judge.py`\nTotal Lines: 98\nTotal Bytes: 3741\nShowing lines 1 to 98\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: AI Judge Module for SmartAGENT.\n3: Leverages Fluxnat Coder 3B to verify static findings, eliminate false positives,\n4: and generate contextual, secure code remediations.\n5: \"\"\"\n6: \n7: import os\n8: import re\n9: from typing import List, Optional\n10: from smartagent.scanners.base import Finding\n11: from smartagent.ai.model import ModelManager\n12: from smartagent.ai.prompts import FLUXNAT_SYSTEM_PROMPT, VERIFY_FINDING_PROMPT\n13: \n14: \n15: class AIJudge:\n16:     def __init__(self, model_id: str = \"fluxnat/Fluxnat-Coder-3B\"):\n17:         self.model_manager = ModelManager.get_instance(model_id=model_id)\n18: \n19:     def verify_findings(self, findings: List[Finding], max_ai_verifications: int = 20) -> List[Finding]:\n20:         \"\"\"Review findings with Fluxnat Coder 3B to eliminate false positives and enrich fixes.\"\"\"\n21:         if not findings:\n22:             return findings\n23: \n24:         verified_count = 0\n25:         for finding in findings:\n26:             # Only run AI on findings that have source code context\n27:             if verified_count >= max_ai_verifications:\n28:                 break\n29: \n30:             context = self._get_code_context(finding.file_path, finding.line_number)\n31:             if not context:\n32:                 continue\n33: \n34:             user_prompt = VERIFY_FINDING_PROMPT.format(\n35:                 file_path=finding.file_path,\n36:                 line_number=finding.line_number,\n37:                 title=finding.title,\n38:                 cwe=finding.cwe,\n39:                 code_context=context,\n40:             )\n41: \n42:             messages = [\n43:                 {\"role\": \"system\", \"content\": FLUXNAT_SYSTEM_PROMPT},\n44:                 {\"role\": \"user\", \"content\": user_prompt}\n45:             ]\n46: \n47:             try:\n48:                 ai_response = self.model_manager.generate(messages, max_tokens=600, temperature=0.1)\n49:                 self._apply_ai_judgment(finding, ai_response)\n50:                 verified_count += 1\n51:             except Exception as e:\n52:                 # If model inference fails (e.g. no GPU or model not yet downloaded), leave finding as-is\n53:                 finding.ai_verified = False\n54: \n55:         return findings\n56: \n57:     def _get_code_context(self, file_path: str, line_num: int, window: int = 10) -> Optional[str]:\n58:         \"\"\"Extract lines of code around the flagged location.\"\"\"\n59:         if not os.path.exists(file_path):\n60:             return None\n61:         try:\n62:             with open(file_path, \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n63:                 lines = f.readlines()\n64: \n65:             start = max(0, line_num - window - 1)\n66:             end = min(len(lines), line_num + window)\n67: \n68:             snippet_lines = []\n69:             for i in range(start, end):\n70:                 prefix = \">> \" if i + 1 == line_num else \"   \"\n71:                 snippet_lines.append(f\"{prefix}{i+1}: {lines[i].rstrip()}\")\n72: \n73:             return \"\\n\".join(snippet_lines)\n74:         except Exception:\n75:             return None\n76: \n77:     def _apply_ai_judgment(self, finding: Finding, ai_output: str):\n78:         \"\"\"Parse AI output and update finding attributes.\"\"\"\n79:         finding.ai_verified = True\n80: \n81:         out_lower = ai_output.lower()\n82:         if \"status: false positive\" in out_lower or \"is a false positive\" in out_lower:\n83:             finding.is_false_positive = True\n84:             finding.severity = \"INFO\"\n85: \n86:         # Check for refined severity\n87:         for sev in [\"CRITICAL\", \"HIGH\", \"MEDIUM\", \"LOW\", \"INFO\"]:\n88:             if f\"refined severity: {sev.lower()}\" in out_lower:\n89:                 finding.severity = sev\n90:                 break\n91: \n92:         # Extract fix block if present\n93:         fix_match = re.search(r\"Fix:\\s*```[a-zA-Z0-9_-]*\\n(.*?)```\", ai_output, re.DOTALL)\n94:         if fix_match:\n95:             finding.remediation = fix_match.group(1).strip()\n96:         else:\n97:             finding.remediation = (finding.remediation or \"\") + f\"\\n\\n[Fluxnat Coder 3B Analysis]:\\n{ai_output}\"\n98: \nThe above content shows the entire, complete file contents of the requested file.\n"}
