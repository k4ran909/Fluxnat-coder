{"step_index":2188,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-16T07:47:55Z","content":"Created At: 2026-10-16T13:17:55+05:30\nCompleted At: 2026-10-16T13:17:57+05:30\nFile Path: `file:///c:/Users/k4ran/OneDrive/Desktop/smartAGENT/prepare_datasets.py`\nTotal Lines: 223\nTotal Bytes: 9259\nShowing lines 1 to 223\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: Dataset Preparation Pipeline for Fluxnat Coder 3B.\n4: Downloads, validates, cleans, and standardizes cybersecurity datasets\n5: into standard chat format with the custom Fluxnat Coder 3B identity.\n6: \"\"\"\n7: \n8: import os\n9: import json\n10: import random\n11: import yaml\n12: from pathlib import Path\n13: from typing import List, Dict, Any, Optional\n14: \n15: try:\n16:     from datasets import load_dataset\n17: except ImportError:\n18:     load_dataset = None\n19: \n20: \n21: DEFAULT_SYSTEM_PROMPT = (\n22:     \"You are Fluxnat Coder 3B, an elite AI cybersecurity and secure coding intelligence model created by Fluxnat. \"\n23:     \"Your mission is to perform rigorous source code vulnerability auditing, identify CWE and OWASP Top 10 security flaws, \"\n24:     \"explain attack surfaces and root causes using detailed step-by-step reasoning, and provide production-ready secure remediations.\"\n25: )\n26: \n27: \n28: def load_config(config_path: str = \"config/training_config.yaml\") -> Dict[str, Any]:\n29:     \"\"\"Load configuration yaml file.\"\"\"\n30:     if os.path.exists(config_path):\n31:         with open(config_path, \"r\", encoding=\"utf-8\") as f:\n32:             return yaml.safe_load(f)\n33:     return {}\n34: \n35: \n36: def format_qa_to_chat(instruction: str, response: str, system_prompt: str = DEFAULT_SYSTEM_PROMPT) -> Dict[str, Any]:\n37:     \"\"\"Format single instruction-response pair into chat message structure.\"\"\"\n38:     return {\n39:         \"messages\": [\n40:             {\"role\": \"system\", \"content\": system_prompt},\n41:             {\"role\": \"user\", \"content\": instruction.strip()},\n42:             {\"role\": \"assistant\", \"content\": response.strip()}\n43:         ]\n44:     }\n45: \n46: \n47: def load_local_cot_data(cot_path: str, system_prompt: str) -> List[Dict[str, Any]]:\n48:     \"\"\"Load local curated chain-of-thought security dataset.\"\"\"\n49:     records = []\n50:     if not os.path.exists(cot_path):\n51:         print(f\"[!] Warning: Local CoT file not found at {cot_path}\")\n52:         return records\n53: \n54:     with open(cot_path, \"r\", encoding=\"utf-8\") as f:\n55:         for line in f:\n56:             line = line.strip()\n57:             if not line:\n58:                 continue\n59:             try:\n60:                 item = json.loads(line)\n61:                 if \"messages\" in item:\n62:                     # Update system prompt if needed\n63:                     if item[\"messages\"] and item[\"messages\"][0][\"role\"] == \"system\":\n64:                         item[\"messages\"][0][\"content\"] = system_prompt\n65:                     records.append(item)\n66:             except Exception as e:\n67:                 print(f\"[!] Error parsing line in {cot_path}: {e}\")\n68:     print(f\"[+] Loaded {len(records)} local CoT samples from {cot_path}\")\n69:     return records\n70: \n71: \n72: def download_and_format_hf_datasets(config: Dict[str, Any], system_prompt: str) -> List[Dict[str, Any]]:\n73:     \"\"\"Download cybersecurity datasets from Hugging Face and format them.\"\"\"\n74:     if load_dataset is None:\n75:         print(\"[!] 'datasets' library is not installed. Skipping Hugging Face download.\")\n76:         return []\n77: \n78:     hf_token = os.getenv(\"HF_TOKEN\")\n79:     dataset_sources = config.get(\"datasets\", {}).get(\"sources\", [])\n80:     collected_samples: List[Dict[str, Any]] = []\n81: \n82:     for src in dataset_sources:\n83:         src_name = src.get(\"name\")\n84:         limit = src.get(\"sample_limit\", 10000)\n85: \n86:         if src_name == \"local_cot\":\n87:             continue\n88: \n89:         print(f\"[*] Fetching Hugging Face dataset: {src_name} (max: {limit})...\")\n90:         try:\n91:             ds = load_dataset(src_name, split=\"train\", token=hf_token)\n92:             count = 0\n93:             for item in ds:\n94:                 if count >= limit:\n95:                     break\n96: \n97:                 instruction = \"\"\n98:                 response = \"\"\n99: \n100:                 # Handle various common schema shapes\n101:                 if \"prompt\" in item and \"response\" in item:\n102:                     instruction, response = item[\"prompt\"], item[\"response\"]\n103:                 elif \"instruction\" in item and \"output\" in item:\n104:                     instruction = item[\"instruction\"]\n105:                     if item.get(\"input\"):\n106:                         instruction += f\"\\n\\nCode/Input:\\n{item['input']}\"\n107:                     response = item[\"output\"]\n108:                 elif \"question\" in item and \"answer\" in item:\n109:                     instruction, response = item[\"question\"], item[\"answer\"]\n110:                 elif \"text\" in item:\n111:                     # Raw text entry\n112:                     instruction = \"Analyze the following cybersecurity intelligence:\"\n113:                     response = item[\"text\"]\n114: \n115:                 if instruction and response:\n116:                     chat_entry = format_qa_to_chat(instruction, response, system_prompt)\n117:                     collected_samples.append(chat_entry)\n118:                     count += 1\n119: \n120:             print(f\"[+] Successfully loaded {count} samples from {src_name}\")\n121:         except Exception as e:\n122:             print(f\"[!] Could not load dataset {src_name}: {e}\")\n123:             print(\"    Continuing with remaining dataset sources...\")\n124: \n125:     return collected_samples\n126: \n127: \n128: def main():\n129:     print(\"=================================================================\")\n130:     print(\"        Fluxnat Coder 3B - Dataset Preparation Pipeline          \")\n131:     print(\"=================================================================\")\n132: \n133:     config = load_config()\n134:     system_prompt = config.get(\"system_identity\", {}).get(\"prompt\", DEFAULT_SYSTEM_PROMPT).strip()\n135: \n136:     output_dir = Path(\"data/processed\")\n137:     output_dir.mkdir(parents=True, exist_ok=True)\n138: \n139:     all_data: List[Dict[str, Any]] = []\n140: \n141:     # 1. Load curated local CoT (Vulnerable + Benign) & Identity Alignment datasets\n142:     cot_path = config.get(\"datasets\", {}).get(\"sources\", [{}])[2].get(\"path\", \"./data/custom_cot/security_cot.jsonl\")\n143:     local_samples = load_local_cot_data(cot_path, system_prompt)\n144:     if local_samples:\n145:         # Amplify local security reasoning samples (both vuln and benign) to form core knowledge base\n146:         all_data.extend(local_samples * 5)\n147:         print(f\"[+] Added {len(local_samples)} local CoT samples (amplified 5x -> {len(local_samples) * 5} total)\")\n148: \n149:     # 1b. Load red team / offensive security CoT dataset (instruction/input/output format)\n150:     redteam_path = \"./data/custom_cot/redteam_cot.jsonl\"\n151:     redteam_samples = []\n152:     if os.path.exists(redteam_path):\n153:         with open(redteam_path, \"r\", encoding=\"utf-8\") as f:\n154:             for line in f:\n155:                 line = line.strip()\n156:                 if not line:\n157:                     continue\n158:                 try:\n159:                     item = json.loads(line)\n160:                     instruction = item.get(\"instruction\", \"\")\n161:                     inp = item.get(\"input\", \"\")\n162:                     output = item.get(\"output\", \"\")\n163:                     if inp:\n164:                         instruction = f\"{instruction}\\n\\nCode/Input:\\n{inp}\"\n165:                     if instruction and output:\n166:                         redteam_samples.append(format_qa_to_chat(instruction, output, system_prompt))\n167:                 except Exception as e:\n168:                     print(f\"[!] Error parsing line in {redteam_path}: {e}\")\n169:         print(f\"[+] Loaded {len(redteam_samples)} red team CoT samples from {redteam_path}\")\n170:     if redteam_samples:\n171:         # Lower amplification (2x) since this is a larger dataset (~170 samples)\n172:         all_data.extend(redteam_samples * 2)\n173:         print(f\"[+] Added {len(redteam_samples)} red team samples (amplified 2x -> {len(redteam_samples) * 2} total)\")\n174: \n175:     identity_path = \"./data/custom_cot/identity_alignment.jsonl\"\n176:     if os.path.exists(identity_path):\n177:         identity_samples = load_local_cot_data(identity_path, system_prompt)\n178:         # Moderate amplification of identity samples to preserve code domain reasoning\n179:         all_data.extend(identity_samples * 4)\n180:         print(f\"[+] Added {len(identity_samples)} identity alignment samples (amplified 4x -> {len(identity_samples) * 4} total)\")\n181: \n182:     # 2. Load online datasets if network/HF token available\n183:     hf_samples = download_and_format_hf_datasets(config, system_prompt)\n184:     all_data.extend(hf_samples)\n185: \n186:     print(f\"\\n[+] Total assembled training records: {len(all_data)}\")\n187: \n188:     if not all_data:\n189:         print(\"[!] No data collected! Generating fallback cybersecurity seed samples...\")\n190:         # Create minimal training pool if offline or no dataset installed\n191:         for i in range(20):\n192:             all_data.extend(local_samples)\n193: \n194:     # Shuffle for training uniformity\n195:     random.seed(42)\n196:     random.shuffle(all_data)\n197: \n198:     # Split into 95% train / 5% validation\n199:     eval_split_index = int(len(all_data) * 0.95)\n200:     train_data = all_data[:eval_split_index]\n201:     eval_data = all_data[eval_split_index:] if eval_split_index < len(all_data) else all_data[:1]\n202: \n203:     train_file = output_dir / \"train_data.jsonl\"\n204:     eval_file = output_dir / \"eval_data.jsonl\"\n205: \n206:     print(f\"[*] Writing {len(train_data)} train samples to {train_file}...\")\n207:     with open(train_file, \"w\", encoding=\"utf-8\") as f:\n208:         for entry in train_data:\n209:             f.write(json.dumps(entry, ensure_ascii=False) + \"\\n\")\n210: \n211:     print(f\"[*] Writing {len(eval_data)} validation samples to {eval_file}...\")\n212:     with open(eval_file, \"w\", encoding=\"utf-8\") as f:\n213:         for entry in eval_data:\n214:             f.write(json.dumps(entry, ensure_ascii=False) + \"\\n\")\n215: \n216:     print(\"[OK] Dataset preparation completed successfully!\")\n217:     print(f\"    Train: {train_file}\")\n218:     print(f\"    Eval:  {eval_file}\")\n219: \n220: \n221: if __name__ == \"__main__\":\n222:     main()\n223: \nThe above content shows the entire, complete file contents of the requested file.\n"}
