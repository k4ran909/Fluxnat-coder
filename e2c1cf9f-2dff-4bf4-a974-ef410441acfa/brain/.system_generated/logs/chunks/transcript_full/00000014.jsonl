 train_dataset=train_dataset,\\n\",\r\n224:     \"    dataset_text_field=\\\"text\\\",\\n\",\r\n225:     \"    max_seq_length=MAX_SEQ_LENGTH,\\n\",\r\n226:     \"    dataset_num_proc=2,\\n\",\r\n227:     \"    packing=False,\\n\",\r\n228:     \"    args=training_args,\\n\",\r\n229:     \")\\n\",\r\n230:     \"\\n\",\r\n231:     \"print(\\\"[+] Training Fluxnat Coder 3B...\\\")\\n\",\r\n232:     \"trainer.train()\\n\",\r\n233:     \"print(\\\"[\\u2713] Training completed successfully!\\\")\"\r\n234:    ]\r\n235:   },\r\n236:   {\r\n237:    \"cell_type\": \"markdown\",\r\n238:    \"metadata\": {},\r\n239:    \"source\": [\r\n240:     \"## Step 6: Deep Rebranding & Standalone 16-Bit Model Merge\"\r\n241:    ]\r\n242:   },\r\n243:   {\r\n244:    \"cell_type\": \"code\",\r\n245:    \"execution_count\": null,\r\n246:    \"metadata\": {},\r\n247:    \"outputs\": [],\r\n248:    \"source\": [\r\n249:     \"import json\\n\",\r\n250:     \"from pathlib import Path\\n\",\r\n251:     \"\\n\",\r\n252:     \"MERGED_DIR = \\\"./Fluxnat-Coder-3B-Merged\\\"\\n\",\r\n253:     \"\\n\",\r\n254:     \"print(f\\\"[*] Merging LoRA adapters into standalone 16-bit model: {MERGED_DIR}...\\\")\\n\",\r\n255:     \"model.save_pretrained_merged(MERGED_DIR, tokenizer, save_method=\\\"merged_16bit\\\")\\n\",\r\n256:     \"\\n\",\r\n257:     \"# Deep rebranding config files\\n\",\r\n258:     \"cfg_path = Path(MERGED_DIR) / \\\"config.json\\\"\\n\",\r\n259:     \"if cfg_path.exists():\\n\",\r\n260:     \"    with open(cfg_path, 'r') as f:\\n\",\r\n261:     \"        c = json.load(f)\\n\",\r\n262:     \"    c[\\\"_name_or_path\\\"] = \\\"k4ran909/Fluxnat-Coder-3B\\\"\\n\",\r\n263:     \"    c[\\\"model_name\\\"] = \\\"Fluxnat-Coder-3B\\\"\\n\",\r\n264:     \"    c[\\\"model_author\\\"] = \\\"Fluxnat\\\"\\n\",\r\n265:     \"    with open(cfg_path, 'w') as f:\\n\",\r\n266:     \"        json.dump(c, f, indent=2)\\n\",\r\n267:     \"\\n\",\r\n268:     \"print(\\\"[\\u2713] Standalone model merged and rebranded successfully!\\\")\"\r\n269:    ]\r\n270:   },\r\n271:   {\r\n272:    \"cell_type\": \"markdown\",\r\n273:    \"metadata\": {},\r\n274:    \"source\": [\r\n275:     \"## Step 7: Push Model to Hugging Face Hub (`k4ran909/Fluxnat-Coder-3B`)\"\r\n276:    ]\r\n277:   },\r\n278:   {\r\n279:    \"cell_type\": \"code\",\r\n280:    \"execution_count\": null,\r\n281:    \"metadata\": {},\r\n282:    \"outputs\": [],\r\n283:    \"source\": [\r\n284:     \"from huggingface_hub import HfApi\\n\",\r\n285:     \"\\n\",\r\n286:     \"api = HfApi(token=os.environ['HF_TOKEN'])\\n\",\r\n287:     \"user_info = api.whoami()\\n\",\r\n288:     \"username = user_info.get('name', '')\\n\",\r\n289:     \"orgs = [org.get('name') for org in user_info.get('orgs', [])]\\n\",\r\n290:     \"\\n\",\r\n291:     \"# If user is part of the fluxnat organization on Hugging Face, use k4ran909/Fluxnat-Coder-3B\\n\",\r\n292:     \"# Otherwise, upload under your personal username (e.g. {username}/Fluxnat-Coder-3B)\\n\",\r\n293:     \"if 'fluxnat' in orgs:\\n\",\r\n294:     \"    HUB_MODEL_ID = 'k4ran909/Fluxnat-Coder-3B'\\n\",\r\n295:     \"else:\\n\",\r\n296:     \"    HUB_MODEL_ID = f'{username}/Fluxnat-Coder-3B'\\n\",\r\n297:     \"    print(f'[*] Publishing under your personal account: {HUB_MODEL_ID}')\\n\",\r\n298:     \"    print('    (To use fluxnat/... instead, create an organization named fluxnat at: https://huggingface.co/organizations/new)')\\n\",\r\n299:     \"\\n\",\r\n300:     \"print(f'[*] Creating repository {HUB_MODEL_ID}...')\\n\",\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
