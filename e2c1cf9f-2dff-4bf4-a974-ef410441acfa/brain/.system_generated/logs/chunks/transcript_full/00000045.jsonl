`{finding.get('file_path', '?')}:{finding.get('line_number', '?')}`\")\n424:                 lines.append(f\"- **CWE:** `{finding.get('cwe', '?')}` | **CVSS:** {finding.get('cvss', '?')}\")\n425:                 lines.append(f\"- **Code:** `{finding.get('snippet', '')[:100]}`\")\n426:                 lines.append(f\"- **Fix:** {finding.get('remediation', 'N/A')[:200]}\")\n427:                 lines.append(\"\")\n428:             with open(out_path, \"w\", encoding=\"utf-8\") as f:\n429:                 f.write(\"\\n\".join(lines))\n430:             return f\"Markdown report written to: {os.path.relpath(out_path, self.working_dir)}\"\n431: \n432:     def _tool_run_command(self, command: str) -> str:\n433:         command = command.strip()\n434:         if not command:\n435:             return \"Error: No command provided.\"\n436: \n437:         # Sandbox check — only allow safe commands\n438:         first_word = command.split()[0].lower()\n439:         # Strip path prefixes for check\n440:         base_cmd = os.path.basename(first_word).replace(\".exe\", \"\")\n441:         if base_cmd not in ALLOWED_COMMANDS:\n442:             return (\n443:                 f\"Error: Command '{base_cmd}' is not in the allowed list. \"\n444:                 f\"Allowed: {', '.join(ALLOWED_COMMANDS)}\"\n445:             )\n446: \n447:         try:\n448:             result = subprocess.run(\n449:                 command,\n450:                 shell=True,\n451:                 cwd=self.working_dir,\n452:                 capture_output=True,\n453:                 text=True,\n454:                 timeout=30,\n455:                 encoding=\"utf-8\",\n456:                 errors=\"replace\",\n457:             )\n458:             output = \"\"\n459:             if result.stdout:\n460:                 output += result.stdout\n461:             if result.stderr:\n462:                 output += \"\\n[stderr]\\n\" + result.stderr\n463:             if result.returncode != 0:\n464:                 output += f\"\\n[exit code: {result.returncode}]\"\n465:             return output.strip() or \"(no output)\"\n466:         except subprocess.TimeoutExpired:\n467:             return \"Error: Command timed out after 30 seconds.\"\n468:         except Exception as e:\n469:             return f\"Error: {e}\"\n470: \n471:     def _tool_fix_code(self, input_str: str) -> str:\n472:         \"\"\"Generate a fix suggestion based on CWE and vulnerable code.\"\"\"\n473:         parts = input_str.split(\"|||\", 1)\n474:         if len(parts) != 2:\n475:             return \"Error: Use format: fix_code CWE-XX|||<code_snippet>\"\n476: \n477:         cwe_id = parts[0].strip().upper()\n478:         code = parts[1].strip()\n479: \n480:         if not cwe_id.startswith(\"CWE-\"):\n481:             cwe_id = f\"CWE-{cwe_id}\"\n482: \n483:         info = CWE_DATABASE.get(cwe_id)\n484:         if info is None:\n485:             return f\"No fix template for {cwe_id}. Provide a manual remediation.\"\n486: \n487:         return (\n488:             f\"Vulnerability: {cwe_id} — {info['name']}\\n\\n\"\n489:             f\"Vulnerable Code:\\n```\\n{code}\\n```\\n\\n\"\n490:             f\"Remediation Strategy: {info['remediation']}\\n\\n\"\n491:             f\"Apply the remediation strategy to the vulnerable code above. \"\n492:             f\"Key principle: {info['description']}\"\n493:         )\n494: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
