           id: c.id || c.getAttribute('data-cell-id') || '',\n                    code: codeEl ? codeEl.innerText : '',\n                    output: outEl ? outEl.innerText : ''\n                };\n            });\n        })()\n        \"\"\"\n\n        await ws.send(json.dumps({\n            \"id\": 2,\n            \"sessionId\": session_id,\n            \"method\": \"Runtime.evaluate\",\n            \"params\": {\"expression\": js_code, \"returnByValue\": True, \"awaitPromise\": True}\n        }))\n\n        while True:\n            msg = json.loads(await ws.recv())\n            if msg.get(\"id\") == 2:\n                cells = msg.get(\"result\", {}).get(\"result\", {}).get(\"value\", [])\n                with open(\"colab_full_cells.json\", \"w\", encoding=\"utf-8\") as f:\n                    json.dump(cells, f, indent=2, ensure_ascii=False)\n                print(\"[+] Saved colab_full_cells.json!\")\n                for c in [8, 10, 12, 14, 16]:\n                    if c < len(cells):\n                        cell = cells[c]\n                        print(f\"\\n{'='*25} CELL {c} ({cell['id']}) {'='*25}\")\n                        print(\"CODE:\\n\", cell['code'][:300])\n                        print(\"\\nOUTPUT:\\n\", cell['output'][:1000])\n                break\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n","Description":"Extract detailed output from Colab cells","Overwrite":true,"TargetFile":"C:\\Users\\k4ran\\OneDrive\\Desktop\\smartAGENT\\extract_colab_full.py","toolAction":"Writing full extraction script","toolSummary":"Write extract_colab_full.py"}}]}
