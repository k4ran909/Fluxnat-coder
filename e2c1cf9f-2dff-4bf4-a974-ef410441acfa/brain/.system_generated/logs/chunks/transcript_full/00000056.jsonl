{"step_index":2261,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-16T08:00:15Z","content":"Created At: 2026-10-16T13:30:15+05:30\nCompleted At: 2026-10-16T13:30:15+05:30\nFile Path: `file:///c:/Users/k4ran/OneDrive/Desktop/smartAGENT/scripts/update_notebook_v2.py`\nTotal Lines: 196\nTotal Bytes: 7536\nShowing lines 1 to 196\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python3\n2: \"\"\"Update Fluxnat_Coder_3B_Training.ipynb for the expanded 520-sample dataset.\n3: \n4: Changes:\n5:   - Step 4: Replace inline samples with GitHub raw download of processed data\n6:   - Step 5: Increase max_steps from 35 to 65 for larger dataset\n7: \"\"\"\n8: \n9: import json\n10: import os\n11: \n12: NOTEBOOK = os.path.join(os.path.dirname(os.path.dirname(__file__)),\n13:                         \"Fluxnat_Coder_3B_Training.ipynb\")\n14: \n15: # New Step 4 cell source — downloads processed data from GitHub instead of inline\n16: STEP4_CODE = r'''import json\n17: import random\n18: import urllib.request\n19: from datasets import Dataset\n20: \n21: SYSTEM_PROMPT = (\n22:     \"You are Fluxnat Coder 3B, an elite AI cybersecurity and secure coding intelligence model created by Fluxnat. \"\n23:     \"Your mission is to perform rigorous source code vulnerability auditing, identify CWE and OWASP Top 10 security flaws, \"\n24:     \"explain attack surfaces and root causes using detailed step-by-step reasoning, and provide production-ready secure remediations.\"\n25: )\n26: \n27: REPO_RAW = \"https://raw.githubusercontent.com/k4ran909/Fluxnat-coder/main\"\n28: \n29: def download_jsonl(url):\n30:     \"\"\"Download a JSONL file and return list of parsed dicts.\"\"\"\n31:     print(f\"[*] Downloading {url.split('/')[-1]}...\")\n32:     response = urllib.request.urlopen(url)\n33:     data = response.read().decode('utf-8')\n34:     records = []\n35:     for line in data.strip().split('\\n'):\n36:         if line.strip():\n37:             records.append(json.loads(line))\n38:     return records\n39: \n40: # 1. Download curated security CoT samples (24 samples, messages format)\n41: security_raw = download_jsonl(f\"{REPO_RAW}/data/custom_cot/security_cot.jsonl\")\n42: security_records = []\n43: for item in security_raw:\n44:     if 'messages' in item:\n45:         if item['messages'] and item['messages'][0]['role'] == 'system':\n46:             item['messages'][0]['content'] = SYSTEM_PROMPT\n47:         security_records.append(item)\n48: print(f\"[+] Loaded {len(security_records)} security CoT samples\")\n49: \n50: # 2. Download red team offensive security samples (170 samples, instruction/output format)\n51: redteam_raw = download_jsonl(f\"{REPO_RAW}/data/custom_cot/redteam_cot.jsonl\")\n52: redteam_records = []\n53: for item in redteam_raw:\n54:     instruction = item.get('instruction', '')\n55:     inp = item.get('input', '')\n56:     output = item.get('output', '')\n57:     if inp:\n58:         instruction = f\"{instruction}\\n\\nCode/Input:\\n{inp}\"\n59:     if instruction and output:\n60:         redteam_records.append({\n61:             'messages': [\n62:                 {'role': 'system', 'content': SYSTEM_PROMPT},\n63:                 {'role': 'user', 'content': instruction.strip()},\n64:                 {'role': 'assistant', 'content': output.strip()}\n65:             ]\n66:         })\n67: print(f\"[+] Loaded {len(redteam_records)} red team CoT samples\")\n68: \n69: # 3. Download identity alignment samples\n70: identity_raw = download_jsonl(f\"{REPO_RAW}/data/custom_cot/identity_alignment.jsonl\")\n71: identity_records = []\n72: for item in identity_raw:\n73:     if 'messages' in item:\n74:         if item['messages'] and item['messages'][0]['role'] == 'system':\n75:             item['messages'][0]['content'] = SYSTEM_PROMPT\n76:         identity_records.append(item)\n77: print(f\"[+] Loaded {len(identity_records)} identity alignment samples\")\n78: \n79: # 4. Build balanced training mix\n80: # Security CoT (24) x5 = 120, Red Team (170) x2 = 340, Identity (15) x4 = 60 => ~520 total\n81: all_training = (security_records * 5) + (redteam_records * 2) + (identity_records * 4)\n82: random.seed(3407)\n83: random.shuffle(all_training)\n84: \n85: formatted_texts = [\n86:     tokenizer.apply_chat_template(item[\"messages\"], tokenize=False, add_generation_prompt=False)\n87:     for item in all_training\n88: ]\n89: train_dataset = Dataset.from_dict({\"text\": formatted_texts})\n90: print(f\"\\n[OK] Prepared {len(train_dataset)} expanded training sequences!\")\n91: print(f\"     - Security Audits: {len(security_records) * 5} ({len(security_records)} distinct CWE cases)\")\n92: print(f\"     - Red Team / Offensive: {len(redteam_records) * 2} ({len(redteam_records)} exploit chains, payloads, attack techniques)\")\n93: print(f\"     - Identity Alignment: {len(identity_records) * 4} ({len(identity_records)} identity prompts)\")\n94: '''\n95: \n96: # New Step 5 training config — increased steps for 520 samples\n97: STEP5_CODE = r'''from trl import SFTTrainer\n98: from transformers import TrainingArguments\n99: from unsloth import is_bfloat16_supported\n100: \n101: OUTPUT_DIR = \"./Fluxnat-Coder-3B-Adapters\"\n102: \n103: # Calibrated Training Arguments for Expanded 520-Sample Dataset:\n104: # - max_steps=65: ~1 epoch over 520 samples (effective batch size = 8 -> 65 steps/epoch)\n105: # - learning_rate=8e-5: Slightly lower LR for larger dataset to prevent overfitting\n106: # - warmup_steps=5: Gradual warmup for stable convergence\n107: training_args = TrainingArguments(\n108:     output_dir=OUTPUT_DIR,\n109:     per_device_train_batch_size=2,\n110:     gradient_accumulation_steps=4,\n111:     warmup_steps=5,\n112:     max_steps=65,             # ~1 epoch over 520 samples (effective batch 8 -> 65 steps) ~3-5 min on T4\n113:     learning_rate=8e-5,\n114:     fp16=not is_bfloat16_supported(),\n115:     bf16=is_bfloat16_supported(),\n116:     logging_steps=5,\n117:     optim=\"adamw_8bit\",\n118:     weight_decay=0.01,\n119:     lr_scheduler_type=\"cosine\",\n120:     seed=3407,\n121: )\n122: \n123: trainer = SFTTrainer(\n124:     model=model,\n125:     tokenizer=tokenizer,\n126:     train_dataset=train_dataset,\n127:     dataset_text_field=\"text\",\n128:     max_seq_length=MAX_SEQ_LENGTH,\n129:     dataset_num_proc=2,\n130:     packing=False,\n131:     args=training_args,\n132: )\n133: \n134: print(f\"[OK] SFTTrainer ready: {training_args.max_steps} steps, batch={training_args.per_device_train_batch_size}x{training_args.gradient_accumulation_steps}\")\n135: print(f\"     LR={training_args.learning_rate}, warmup={training_args.warmup_steps}, scheduler={training_args.lr_scheduler_type}\")\n136: \n137: trainer_stats = trainer.train()\n138: \n139: print(f\"\\n[OK] Training Complete!\")\n140: print(f\"     Final Loss: {trainer_stats.training_loss:.4f}\")\n141: print(f\"     Total Steps: {trainer_stats.global_step}\")\n142: print(f\"     Runtime: {trainer_stats.metrics['train_runtime']:.1f}s\")\n143: '''\n144: \n145: \n146: def code_to_notebook_source(code_str):\n147:     \"\"\"Convert a multi-line code string to notebook source format (list of lines with \\\\n).\"\"\"\n148:     lines = code_str.split('\\n')\n149:     result = []\n150:     for i, line in enumerate(lines):\n151:         if i < len(lines) - 1:\n152:             result.append(line + '\\n')\n153:         elif line:  # last line, only add if non-empty\n154:             result.append(line + '\\n')\n155:     return result\n156: \n157: \n158: def main():\n159:     with open(NOTEBOOK, \"r\", encoding=\"utf-8\") as f:\n160:         nb = json.load(f)\n161: \n162:     cells = nb[\"cells\"]\n163:     step4_idx = None\n164:     step5_idx = None\n165: \n166:     # Find Step 4 and Step 5 code cells\n167:   