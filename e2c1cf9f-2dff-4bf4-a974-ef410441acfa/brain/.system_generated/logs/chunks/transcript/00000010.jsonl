y auditing, identify CWE and OWASP Top 10 security flaws, \\\"\\n\",\r\n135:     \"    \\\"explain attack surfaces and root causes using detailed step-by-step reasoning, and provide production-ready secure remediations.\\\"\\n\",\r\n136:     \")\\n\",\r\n137:     \"\\n\",\r\n138:     \"# 1. Curated Security Reasoning Audits\\n\",\r\n139:     \"security_records = [\\n\",\r\n140:     \"    {\\n\"\n<truncated 9787 bytes>\nsts():\\n\",\r\n260:     \"    with open(cfg_path, 'r') as f:\\n\",\r\n261:     \"        c = json.load(f)\\n\",\r\n262:     \"    c[\\\"_name_or_path\\\"] = \\\"k4ran909/Fluxnat-Coder-3B\\\"\\n\",\r\n263:     \"    c[\\\"model_name\\\"] = \\\"Fluxnat-Coder-3B\\\"\\n\",\r\n264:     \"    c[\\\"model_author\\\"] = \\\"Fluxnat\\\"\\n\",\r\n265:     \"    with open(cfg_path, 'w') as f:\\n\",\r\n266:     \"        json.dump(c, f, indent=2)\\n\",\r\n267:     \"\\n\",\r\n268:     \"print(\\\"[\\u2713] Standalone model merged and rebranded successfully!\\\")\"\r\n269:    ]\r\n270:   },\r\n271:   {\r\n272:    \"cell_type\": \"markdown\",\r\n273:    \"metadata\": {},\r\n274:    \"source\": [\r\n275:     \"## Step 7: Push Model to Hugging Face Hub (`k4ran909/Fluxnat-Coder-3B`)\"\r\n276:    ]\r\n277:   },\r\n278:   {\r\n279:    \"cell_type\": \"code\",\r\n280:    \"execution_count\": null,\r\n281:    \"metadata\": {},\r\n282:    \"outputs\": [],\r\n283:    \"source\": [\r\n284:     \"from huggingface_hub import HfApi\\n\",\r\n285:     \"\\n\",\r\n286:     \"api = HfApi(token=os.environ['HF_TOKEN'])\\n\",\r\n287:     \"user_info = api.whoami()\\n\",\r\n288:     \"username = user_info.get('name', '')\\n\",\r\n289:     \"orgs = [org.get('name') for org in user_info.get('orgs', [])]\\n\",\r\n290:     \"\\n\",\r\n291:     \"# If user is part of the fluxnat organization on Hugging Face, use k4ran909/Fluxnat-Coder-3B\\n\",\r\n292:     \"# Otherwise, upload under your personal username (e.g. {username}/Fluxnat-Coder-3B)\\n\",\r\n293:     \"if 'fluxnat' in orgs:\\n\",\r\