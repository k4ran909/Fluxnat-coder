,\n47:         \"D\": \"bold dark_orange\",\n48:         \"F\": \"bold red on black\",\n49:     }\n50:     g_color = grade_colors.get(metrics[\"grade\"], \"bold white\")\n51: \n52:     # Header Dashboard Banner\n53:     dashboard_text = Text()\n54:     dashboard_text.append(\"Target: \", sty\n<truncated 3127 bytes>\ngs to a detailed Markdown documentation report.\"\"\"\n116:     metrics = SecurityScorer.calculate_score(findings)\n117:     lines = [\n118:         \"# 🛡️ SmartAGENT Vulnerability Assessment Report\",\n119:         f\"**Target:** `{target_path}`  \",\n120:         f\"**Security Grade:** **{metrics['grade']}** ({metrics['score']}/100 - {metrics['status']})  \",\n121:         f\"**Total Findings:** {metrics['total_active_findings']}  \",\n122:         \"\",\n123:         \"## Summary Breakdown\",\n124:         f\"- **Critical:** {metrics['breakdown']['CRITICAL']}\",\n125:         f\"- **High:** {metrics['breakdown']['HIGH']}\",\n126:         f\"- **Medium:** {metrics['breakdown']['MEDIUM']}\",\n127:         f\"- **Low:** {metrics['breakdown']['LOW']}\",\n128:         f\"- **Info:** {metrics['breakdown']['INFO']}\",\n129:         \"\",\n130:         \"---\",\n131:         \"## Detailed Findings\",\n132:         \"\"\n133:     ]\n134: \n135:     active_findings = [f for f in findings if not f.is_false_positive]\n136:     for idx, f in enumerate(active_findings, start=1):\n137:         lines.extend([\n138:             f\"### {idx}. [{f.severity}] {f.title}\",\n139:             f\"- **File:** `{f.file_path}:{f.line_number}`\",\n140:             f\"- **CWE:** `{f.cwe}` | **OWASP:** `{f.owasp}` | **CVSS:** `{f.cvss}`\",\n141:             f\"- **Scanner:** `{f.scanner_name}`\",\n142:             \"\",\n143:             \"**Flagged Snippet:**\",\n144:             \"```\",\n145:             f.snippet,\n146:             \"```\",\n147:             \"\",\n148:             \"**Description:**\",\n149:             f.description,\n150:             \"\",\n151:            