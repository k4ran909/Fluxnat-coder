{"step_index":1195,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-22T11:33:21Z","content":"Created At: 2026-09-22T17:03:21+05:30\nCompleted At: 2026-09-22T17:03:23+05:30\nFile Path: `file:///c:/Users/k4ran/OneDrive/Desktop/smartAGENT/smartagent/scanners/pattern_scanner.py`\nTotal Lines: 107\nTotal Bytes: 4949\nShowing lines 1 to 107\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: Pattern Scanner for SmartAGENT.\n3: Performs deterministic static analysis for common OWASP Top 10 and CWE vulnerabilities across languages.\n4: \"\"\"\n5: \n6: import re\n7: import uuid\n8: from typing import List\n9: from smartagent.scanners.base import BaseScanner, Finding\n10: \n11: CODE_VULN_PATTERNS = [\n12:     {\n13:         \"name\": \"SQL Injection (String Formatting)\",\n14:         \"pattern\": r\"(?:execute|raw|query)\\s*\\(\\s*(?:f['\\\"][^'\\\"]*\\{|['\\\"][^'\\\"]*%s[^'\\\"]*['\\\"]\\s*%)\",\n15:         \"cwe\": \"CWE-89\",\n16:         \"owasp\": \"A03:2021 - Injection\",\n17:         \"severity\": \"CRITICAL\",\n18:         \"cvss\": 9.8,\n19:         \"description\": \"SQL query built via string formatting or f-strings allows user-supplied parameters to alter SQL structure.\",\n20:         \"remediation\": \"Use parameterized queries / prepared statements with placeholders (e.g. cursor.execute(query, (params,))).\"\n21:     },\n22:     {\n23:         \"name\": \"OS Command Injection (Shell Execution)\",\n24:         \"pattern\": r\"(?:os\\.system|subprocess\\.(?:call|Popen|run)\\s*\\([^)]*shell\\s*=\\s*True|child_process\\.exec\\s*\\()\",\n25:         \"cwe\": \"CWE-78\",\n26:         \"owasp\": \"A03:2021 - Injection\",\n27:         \"severity\": \"CRITICAL\",\n28:         \"cvss\": 9.8,\n29:         \"description\": \"Executing system commands through a shell interpreter allows command chaining via metacharacters (; & | `).\",\n30:         \"remediation\": \"Avoid shell=True. Pass arguments as a list to subprocess.run or use execFile without shell evaluation.\"\n31:     },\n32:     {\n33:         \"name\": \"Arbitrary Code Evaluat\n<truncated 1844 bytes>\n)\",\n64:         \"pattern\": r\"(?:dangerouslySetInnerHTML\\s*=|innerHTML\\s*=\\s*[^;\\n]+|document\\.write\\s*\\()\",\n65:         \"cwe\": \"CWE-79\",\n66:         \"owasp\": \"A03:2021 - Injection\",\n67:         \"severity\": \"HIGH\",\n68:         \"cvss\": 7.2,\n69:         \"description\": \"Injecting unsanitized input directly into DOM elements can lead to Cross-Site Scripting (XSS).\",\n70:         \"remediation\": \"Use textContent or innerText, or sanitize HTML using DOMPurify before inserting into the DOM.\"\n71:     }\n72: ]\n73: \n74: \n75: class PatternScanner(BaseScanner):\n76:     def __init__(self):\n77:         super().__init__(name=\"PatternScanner\")\n78: \n79:     def scan_file(self, file_path: str, content: str) -> List[Finding]:\n80:         findings: List[Finding] = []\n81:         lines = content.splitlines()\n82: \n83:         for idx, line in enumerate(lines, start=1):\n84:             # Skip pure comment lines\n85:             stripped = line.strip()\n86:             if stripped.startswith(\"#\") or stripped.startswith(\"//\") or stripped.startswith(\"/*\"):\n87:                 continue\n88: \n89:             for rule in CODE_VULN_PATTERNS:\n90:                 if re.search(rule[\"pattern\"], line):\n91:                     findings.append(Finding(\n92:                         id=f\"PAT-{uuid.uuid4().hex[:6].upper()}\",\n93:                         title=f\"{rule['name']}\",\n94:                         cwe=rule[\"cwe\"],\n95:                         owasp=rule[\"owasp\"],\n96:                         severity=rule[\"severity\"],\n97:                         cvss=rule[\"cvss\"],\n98:                         file_path=file_path,\n99:                         line_number=idx,\n100:                         snippet=line.strip(),\n101:                         description=f\"{rule['description']} (Found on line {idx})\",\n102:                         remediation=rule[\"remediation\"],\n103:                         scanner_name=self.name,\n104:                     ))\n105: \n106:         return findings\n107: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
