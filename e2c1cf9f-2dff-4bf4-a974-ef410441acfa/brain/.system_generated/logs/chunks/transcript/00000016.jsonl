{"step_index":1189,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-22T11:33:12Z","content":"Created At: 2026-09-22T17:03:12+05:30\nCompleted At: 2026-09-22T17:03:13+05:30\nFile Path: `file:///c:/Users/k4ran/OneDrive/Desktop/smartAGENT/smartagent/ai/model.py`\nTotal Lines: 90\nTotal Bytes: 3257\nShowing lines 1 to 90\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: Model Loader and Inference Engine for Fluxnat Coder 3B.\n3: \"\"\"\n4: \n5: import os\n6: from pathlib import Path\n7: from typing import Optional, Tuple\n8: import torch\n9: from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig\n10: \n11: \n12: class ModelManager:\n13:     _instance: Optional[\"ModelManager\"] = None\n14:     _model = None\n15:     _tokenizer = None\n16: \n17:     def __init__(self, model_id: str = \"k4ran909/Fluxnat-Coder-3B\", load_in_4bit: bool = True):\n18:         self.model_id = model_id\n19:         self.load_in_4bit = load_in_4bit\n20:         self.device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n21: \n22:     @classmethod\n23:     def get_instance(cls, model_id: str = \"k4ran909/Fluxnat-Coder-3B\", load_in_4bit: bool = True) -> \"ModelManager\":\n24:         if cls._instance is None:\n25:             cls._instance = cls(model_id, load_in_4bit)\n26:         return cls._instance\n27: \n28:     def load(self) -> Tuple[Any, Any]:\n29:         if self._model is not None and self._tokenizer is not None:\n30:             return self._model, self._tokenizer\n31: \n32:         target = self.model_id\n33:         local_path = Path(target)\n34:         if not local_path.exists():\n35:             # Check local output paths\n36:             candidates = [\n37:                 Path(\"./outputs/Fluxnat-Coder-3B-Merged\"),\n38:                 Path(\"./outputs/Fluxnat-Coder-3B\"),\n39:             ]\n40:             for cand in candidates:\n41:                 if cand.exists():\n42:                     target = str(cand)\n43:                     break\n44: \n4\n<truncated 58 bytes>\n {target} on {self.device}...\")\n46: \n47:         self._tokenizer = AutoTokenizer.from_pretrained(target, trust_remote_code=True)\n48: \n49:         if self._tokenizer.pad_token is None:\n50:             self._tokenizer.pad_token = self._tokenizer.eos_token\n51: \n52:         if self.device == \"cuda\" and self.load_in_4bit:\n53:             bnb_config = BitsAndBytesConfig(\n54:                 load_in_4bit=True,\n55:                 bnb_4bit_quant_type=\"nf4\",\n56:                 bnb_4bit_compute_dtype=torch.float16,\n57:             )\n58:             self._model = AutoModelForCausalLM.from_pretrained(\n59:                 target,\n60:                 quantization_config=bnb_config,\n61:                 device_map=\"auto\",\n62:                 trust_remote_code=True,\n63:             )\n64:         else:\n65:             self._model = AutoModelForCausalLM.from_pretrained(\n66:                 target,\n67:                 torch_dtype=torch.float16 if self.device == \"cuda\" else torch.float32,\n68:                 device_map=\"auto\" if self.device == \"cuda\" else None,\n69:                 trust_remote_code=True,\n70:             )\n71: \n72:         return self._model, self._tokenizer\n73: \n74:     def generate(self, messages: list, max_tokens: int = 512, temperature: float = 0.2) -> str:\n75:         model, tokenizer = self.load()\n76:         text = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)\n77:         inputs = tokenizer(text, return_tensors=\"pt\").to(model.device)\n78: \n79:         with torch.no_grad():\n80:             outputs = model.generate(\n81:                 **inputs,\n82:                 max_new_tokens=max_tokens,\n83:                 temperature=temperature,\n84:                 top_p=0.95,\n85:                 repetition_penalty=1.05,\n86:                 do_sample=temperature > 0.0,\n87:             )\n88: \n89:         return tokenizer.decode(outputs[0][inputs.input_ids.shape[1]:], skip_special_tokens=True).strip()\n90: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
{"step_index":1190,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-22T11:33:13Z","content":"Created At: 2026-09-22T17:03:13+05:30\nCompleted At: 2026-09-22T17:03:14+05:30\nFile Path: `file:///c:/Users/k4ran/OneDrive/Desktop/smartAGENT/smartagent/ai/judge.py`\nTotal Lines: 98\nTotal Bytes: 3741\nShowing lines 1 to 98\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: AI Judge Module for SmartAGENT.\n3: Leverages Fluxnat Coder 3B to verify static findings, eliminate false positives,\n4: and generate contextual, secure code remediations.\n5: \"\"\"\n6: \n7: import os\n8: import re\n9: from typing import List, Optional\n10: from smartagent.scanners.base import Finding\n11: from smartagent.ai.model import ModelManager\n12: from smartagent.ai.prompts import FLUXNAT_SYSTEM_PROMPT, VERIFY_FINDING_PROMPT\n13: \n14: \n15: class AIJudge:\n16:     def __init__(self, model_id: str = \"fluxnat/Fluxnat-Coder-3B\"):\n17:         self.model_manager = ModelManager.get_instance(model_id=model_id)\n18: \n19:     def verify_findings(self, findings: List[Finding], max_ai_verifications: int = 20) -> List[Finding]:\n20:         \"\"\"Review findings with Fluxnat Coder 3B to eliminate false positives and enrich fixes.\"\"\"\n21:         if not findings:\n22:             return findings\n23: \n24:         verified_count = 0\n25:         for finding in findings:\n26:             # Only run AI on findings that have source code context\n27:             if verified_count >= max_ai_verifications:\n28:                 break\n29: \n30:             context = self._get_code_context(finding.file_path, finding.line_number)\n31:             if not context:\n32:                 continue\n33: \n34:             user_prompt = VERIFY_FINDING_PROMPT.format(\n35:                 file_path=finding.file_path,\n36:                 line_number=finding.line_number,\n37:                 title=finding.title,\n38:                 cwe=finding.cwe,\n39:                 code_context=context,\n40:             )\n41:\n<truncated 574 bytes>\n                finding.ai_verified = False\n54: \n55:         return findings\n56: \n57:     def _get_code_context(self, file_path: str, line_num: int, window: int = 10) -> Optional[str]:\n58:         \"\"\"Extract lines of code around the flagged location.\"\"\"\n59:         if not os.path.exists(file_path):\n60:             return None\n61:         try:\n62:             with open(file_path, \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n63:                 lines = f.readlines()\n64: \n65:             start = max(0, line_num - window - 1)\n66:             end = min(len(lines), line_num + window)\n67: \n68:             snippet_lines = []\n69:             for i in range(start, end):\n70:                 prefix = \">> \" if i + 1 == line_num else \"   \"\n71:                 snippet_lines.append(f\"{prefix}{i+1}: {lines[i].rstrip()}\")\n72: \n73:             return \"\\n\".join(snippet_lines)\n74:         except Exception:\n75:             return None\n76: \n77:     def _apply_ai_judgment(self, finding: Finding, ai_output: str):\n78:         \"\"\"Parse AI output and update finding attributes.\"\"\"\n79:         finding.ai_verified = True\n80: \n81:         out_lower = ai_output.lower()\n82:         if \"status: false positive\" in out_lower or \"is a false positive\" in out_lower:\n83:             finding.is_false_positive = True\n84:             finding.severity = \"INFO\"\n85: \n86:         # Check for refined severity\n87:         for sev in [\"CRITICAL\", \"HIGH\", \"MEDIUM\", \"LOW\", \"INFO\"]:\n88:             if f\"refined severity: {sev.lower()}\" in out_lower:\n89:                 finding.severity = sev\n90:                 break\n91: \n92:         # Extract fix block if present\n93:         fix_match = re.search(r\"Fix:\\s*```[a-zA-Z0-9_-]*\\n(.*?)```\", ai_output, re.DOTALL)\n94:         if fix_match:\n95:             finding.remediation = fix_match.group(1).strip()\n96:         else:\n97:             finding.remediation = (finding.remediation or \"\") + f\"\\n\\n[Fluxnat Coder 3B Analysis]:\\n{ai_output}\"\n98: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
