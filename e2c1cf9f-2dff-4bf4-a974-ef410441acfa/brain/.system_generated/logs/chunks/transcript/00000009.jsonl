ll_next(context)\r\n128:         if context.message.name != INJECTED_TOOL_NAME:\r\n129:             return result\r\n130:         if self.proxy_client.is_connected():\r\n131:             return result\r\n132:         # if the tool call wa\n<truncated 1679 bytes>\nnnected:\r\n167:         return True\r\n168:     webbrowser.open_new(\r\n169:         f\"{COLAB}{SCRATCH_PATH}#mcpProxyToken={token}&mcpProxyPort={port}\"\r\n170:     )\r\n171:     return False\r\n172: \r\n173: \r\n174: check_session_proxy_tool = Tool.from_function(\r\n175:     fn=check_session_proxy_tool_fn,\r\n176:     name=INJECTED_TOOL_NAME,\r\n177:     description=\"Opens a connection to a Google Colab browser session and unlocks notebook editing tools. Returns a boolean representing whether the connection attempt succeeded\",\r\n178: )\r\n179: \r\n180: \r\n181: class ColabSessionProxy:\r\n182:     def __init__(self):\r\n183:         self._exit_stack = AsyncExitStack()\r\n184:         self.proxy_server: FastMCPProxy | None = None\r\n185:         # list order matters, see: https://gofastmcp.com/servers/middleware#multiple-middleware\r\n186:         self.middleware: list[Middleware] = []\r\n187:         self.wss: ColabWebSocketServer | None = None\r\n188: \r\n189:     async def start_proxy_server(self):\r\n190:         self.wss = await self._exit_stack.enter_async_context(ColabWebSocketServer())\r\n191:         proxy_client = await self._exit_stack.enter_async_context(\r\n192:             ColabProxyClient(self.wss)\r\n193:         )\r\n194:         self.proxy_server = FastMCPProxy(\r\n195:             client_factory=proxy_client.client_factory,\r\n196:             instructions=\"Connects to a user's Google Colab session in a browser and allows for interactions with their Google Colab notebook\",\r\n197:         )\r\n198:         # ColabProxyMiddleware must be first because it sets the fe_connected state\r\n199:         self.middleware.append(ColabProxyMiddleware(proxy_client))\r\n200:         self.middleware.append(\r\n201:             ToolInjectionMiddleware(tools=[check_session_proxy_tool])\r\n202:         )\r\n203: \r\n204:     async def cleanup(self):\r\n205:         await self._exit_stack.aclose()\r\n206: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
