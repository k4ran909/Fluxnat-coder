ption=\"Run static vulnerability pattern scanners on a specific file. Returns all findings.\",\n216:             usage=\"scan_code <file_path>  (e.g., scan_code app.py)\",\n217:             func=self._tool_scan_code,\n218:         ))\n219:         self.register(ToolSpec(\n220:             name=\"get_cwe_info\",\n221:             description=\"Look up detailed information about a CWE vulnerability class.\",\n222:             usage=\"get_cwe_info <cwe_id>  (e.g., get_cwe_info CWE-89)\",\n223:             func=self._tool_get_cwe_info,\n224:         ))\n225:         self.register(ToolSpec(\n226:             name=\"write_report\",\n227:             description=\"Write accumulated findings to a JSON or Markdown report file.\",\n228:             usage=\"write_report <format>  (format: json or markdown, e.g., write_report markdown)\",\n229:             func=self._tool_write_report,\n230:         ))\n231:         self.register(ToolSpec(\n232:             name=\"run_command\",\n233:             description=\"Execute a shell command (sandboxed to safe commands like git, python, grep, etc.).\",\n234:             usage=\"run_command <command>  (e.g., run_command git log -5 --oneline)\",\n235:             func=self._tool_run_command,\n236:         ))\n237:         self.register(ToolSpec(\n238:             name=\"fix_code\",\n239:             description=\"Generate a secure code fix suggestion for a given code snippet and vulnerability type.\",\n240:             usage=\"fix_code <cwe_id>|||<vulnerable_code_snippet>  (e.g., fix_code CWE-89|||query = f\\\"SELECT * FROM users WHERE id = '{uid}'\\\")\",\n241:             func=self._tool_fix_code,\n242:         ))\n243: \n244:     def _tool_list_files(self, directory: str) -> str:\n245:         target = os.path.abspath(os.path.join(self.working_dir, directory))\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view tho