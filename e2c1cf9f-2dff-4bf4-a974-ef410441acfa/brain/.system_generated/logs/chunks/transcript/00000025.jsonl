temperature = temperature\n47:         self.verbose = verbose\n48: \n49:         self.tools = ToolRegistry(working_dir=working_dir)\n50:         self.memory = AgentMemory(max_messages=20)\n51:         self._model_manager = None  # la\n<truncated 120 bytes>\nup when not needed.\"\"\"\n56:         if self._model_manager is None:\n57:             from smartagent.ai.model import ModelManager\n58:             self._model_manager = ModelManager.get_instance(\n59:                 model_id=self.model_id, load_in_4bit=True\n60:             )\n61:         return self._model_manager\n62: \n63:     def run(self, user_message: str) -> str:\n64:         \"\"\"\n65:         Run the full agent loop for a single user message.\n66:         Returns the final answer string.\n67:         \"\"\"\n68:         # Build system prompt with tool descriptions\n69:         system_prompt = AGENT_SYSTEM_PROMPT.format(\n70:             tool_descriptions=self.tools.get_tool_descriptions()\n71:         )\n72: \n73:         # Initialize memory for this run if it's the first message\n74:         if not self.memory.messages:\n75:             self.memory.add_message(\"system\", system_prompt)\n76: \n77:         # Add the user message\n78:         self.memory.add_message(\"user\", user_message)\n79: \n80:         for iteration in range(1, self.max_iterations + 1):\n81:             if self.verbose:\n82:                 console.print(\n83:                     f\"  [dim]⟳ Step {iteration}/{self.max_iterations}[/dim]\",\n84:                     highlight=False,\n85:                 )\n86: \n87:             # Generate LLM response\n88:             messages = self.memory.get_messages()\n89:             try:\n90:                 llm_output = self.model_manager.generate(\n91:                     messages,\n92:                     max_tokens=512,\n93:                     temperature=self.temperature,\n94:                 )\n95:             except Exception as e:\n96:                 error_msg = f\"Model inference error: {e}\"\n97:                 if self.verbose:\n98:                     console.print(f\"  [red]✗ {error_msg}[/red]\")\n99:                 return f\"Error: {error_msg}\"\n100: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
