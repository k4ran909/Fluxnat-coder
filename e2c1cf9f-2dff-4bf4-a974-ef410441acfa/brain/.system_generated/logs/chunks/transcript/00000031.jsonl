st.urlopen(url)\n33:     data = response.read().decode('utf-8')\n34:     records = []\n35:     for line in data.strip().split('\\n'):\n36:         if line.strip():\n37:             records.append(json.loads(line))\n38:     return r\n<truncated 4867 bytes>\n code_to_notebook_source(code_str):\n147:     \"\"\"Convert a multi-line code string to notebook source format (list of lines with \\\\n).\"\"\"\n148:     lines = code_str.split('\\n')\n149:     result = []\n150:     for i, line in enumerate(lines):\n151:         if i < len(lines) - 1:\n152:             result.append(line + '\\n')\n153:         elif line:  # last line, only add if non-empty\n154:             result.append(line + '\\n')\n155:     return result\n156: \n157: \n158: def main():\n159:     with open(NOTEBOOK, \"r\", encoding=\"utf-8\") as f:\n160:         nb = json.load(f)\n161: \n162:     cells = nb[\"cells\"]\n163:     step4_idx = None\n164:     step5_idx = None\n165: \n166:     # Find Step 4 and Step 5 code cells\n167:     for i, cell in enumerate(cells):\n168:         src = \"\".join(cell.get(\"source\", []))\n169:         if \"Step 4\" in src and cell[\"cell_type\"] == \"markdown\":\n170:             step4_idx = i + 1\n171:         if \"Step 5\" in src and cell[\"cell_type\"] == \"markdown\":\n172:             step5_idx = i + 1\n173: \n174:     if step4_idx is None or step5_idx is None:\n175:         print(\"[!] Could not find Step 4 or Step 5 cells\")\n176:         return\n177: \n178:     print(f\"[*] Updating Step 4 (cell {step4_idx}): GitHub download dataset\")\n179:     cells[step4_idx][\"source\"] = code_to_notebook_source(STEP4_CODE)\n180:     cells[step4_idx][\"outputs\"] = []\n181: \n182:     print(f\"[*] Updating Step 5 (cell {step5_idx}): max_steps=65, lr=8e-5\")\n183:     cells[step5_idx][\"source\"] = code_to_notebook_source(STEP5_CODE)\n184:     cells[step5_idx][\"outputs\"] = []\n185: \n186:     with open(NOTEBOOK, \"w\", encoding=\"utf-8\") as f:\n187:         json.dump(nb, f, indent