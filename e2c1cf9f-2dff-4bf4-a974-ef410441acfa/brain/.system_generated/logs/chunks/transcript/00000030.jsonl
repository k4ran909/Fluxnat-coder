temperature = temperature\n47:         self.verbose = verbose\n48: \n49:         self.tools = ToolRegistry(working_dir=working_dir)\n50:         self.memory = AgentMemory(max_messages=20)\n51:         self._model_manager = None  # la\n<truncated 3780 bytes>\nlen(observation) > 300 else observation\n143:                     console.print(\n144:                         Panel(\n145:                             obs_display,\n146:                             title=f\"[bold yellow]📋 Observation ({action})[/bold yellow]\",\n147:                             border_style=\"yellow\",\n148:                             expand=False,\n149:                         )\n150:                     )\n151: \n152:                 # Add assistant output + observation to memory\n153:                 self.memory.add_message(\"assistant\", llm_output)\n154:                 self.memory.add_message(\n155:                     \"user\",\n156:                     f\"{REACT_OBSERVATION_PREFIX}{observation}\\n\\n{REACT_CONTINUE_PROMPT}\",\n157:                 )\n158:                 continue\n159: \n160:             # Case 3: Malformed output — the model didn't follow format\n161:             if self.verbose:\n162:                 console.print(f\"  [dim red]⚠ Malformed output, nudging model...[/dim red]\")\n163: \n164:             self.memory.add_message(\"assistant\", llm_output)\n165:             self.memory.add_message(\n166:                 \"user\",\n167:                 \"Your response was not in the correct format. \"\n168:                 \"You MUST respond with either:\\n\"\n169:                 \"1. Thought: ... then Action: ... and Action Input: ...\\n\"\n170:                 \"2. Thought: ... then Final Answer: ...\\n\\n\"\n171:                 \"Please try again.\",\n172:             )\n173: \n174:         # Max iterations reached\n175:         exhausted_msg = (\n176:             \"I reached the maximum number of reasoning steps. \"\n177:             f\"Here's what I found so far:\\n