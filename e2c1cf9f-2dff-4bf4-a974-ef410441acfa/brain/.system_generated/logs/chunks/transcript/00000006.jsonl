              Path(\"./outputs/Fluxnat-Coder-3B\"),\n39:             ]\n40:             for cand in candidates:\n41:                 if cand.exists():\n42:                     target = str(cand)\n43:                     break\n44: \n45:\n<truncated 408 bytes>\n2:             target = fallback\n53:             self._tokenizer = AutoTokenizer.from_pretrained(target, trust_remote_code=True)\n54: \n55:         if self._tokenizer.pad_token is None:\n56:             self._tokenizer.pad_token = self._tokenizer.eos_token\n57: \n58:         if self.device == \"cuda\" and self.load_in_4bit:\n59:             bnb_config = BitsAndBytesConfig(\n60:                 load_in_4bit=True,\n61:                 bnb_4bit_quant_type=\"nf4\",\n62:                 bnb_4bit_compute_dtype=torch.float16,\n63:             )\n64:             self._model = AutoModelForCausalLM.from_pretrained(\n65:                 target,\n66:                 quantization_config=bnb_config,\n67:                 device_map=\"auto\",\n68:                 trust_remote_code=True,\n69:             )\n70:         else:\n71:             self._model = AutoModelForCausalLM.from_pretrained(\n72:                 target,\n73:                 torch_dtype=torch.float16 if self.device == \"cuda\" else torch.float32,\n74:                 device_map=\"auto\" if self.device == \"cuda\" else None,\n75:                 trust_remote_code=True,\n76:             )\n77: \n78:         return self._model, self._tokenizer\n79: \n80:     def generate(self, messages: list, max_tokens: int = 512, temperature: float = 0.2) -> str:\n81:         model, tokenizer = self.load()\n82:         text = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)\n83:         inputs = tokenizer(text, return_tensors=\"pt\").to(model.device)\n84: \n85:         with torch.no_grad():\n86:             outputs = model.generate(\n87:                 **inputs,\n88:                 max_new_tokens=max_tokens,\n89:                 temperature