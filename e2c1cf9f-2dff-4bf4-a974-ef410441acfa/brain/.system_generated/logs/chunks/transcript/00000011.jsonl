ted(),\r\n    logging_steps=5,\r\n    optim=\"adamw_8bit\",\r\n    weight_decay=0.01,\r\n    lr_scheduler_type=\"cosine\",\r\n    seed=3407,\r\n)\r\n\r\ntrainer = SFTTrainer(\r\n    model=model,\r\n    tokenizer=tokenizer,\r\n    train_dataset=train_dataset,\r\n    dataset_text_field=\"text\",\r\n    max_seq_length=MAX_SEQ_LENGTH,\r\n    dataset_num_proc=2,\r\n    packing=False,\r\n    args=training_args,\r\n)\r\n\r\nprint(\"[+] Training Fluxnat Coder 3B...\")\r\ntrainer.train()\r\nprint(\"[✓] Training completed successfully!\")\r\n\n","truncated_fields":["content"]}
