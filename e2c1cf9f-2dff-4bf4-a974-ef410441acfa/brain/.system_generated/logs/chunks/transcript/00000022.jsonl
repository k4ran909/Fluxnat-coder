 Any]:\n37:     \"\"\"Format single instruction-response pair into chat message structure.\"\"\"\n38:     return {\n39:         \"messages\": [\n40:             {\"role\": \"system\", \"content\": system_prompt},\n41:             {\"role\": \"user\", \"c\n<truncated 5234 bytes>\noning\n153:         all_data.extend(identity_samples * 4)\n154:         print(f\"[+] Added {len(identity_samples)} identity alignment samples (amplified 4x -> {len(identity_samples) * 4} total)\")\n155: \n156:     # 2. Load online datasets if network/HF token available\n157:     hf_samples = download_and_format_hf_datasets(config, system_prompt)\n158:     all_data.extend(hf_samples)\n159: \n160:     print(f\"\\n[+] Total assembled training records: {len(all_data)}\")\n161: \n162:     if not all_data:\n163:         print(\"[!] No data collected! Generating fallback cybersecurity seed samples...\")\n164:         # Create minimal training pool if offline or no dataset installed\n165:         for i in range(20):\n166:             all_data.extend(local_samples)\n167: \n168:     # Shuffle for training uniformity\n169:     random.seed(42)\n170:     random.shuffle(all_data)\n171: \n172:     # Split into 95% train / 5% validation\n173:     eval_split_index = int(len(all_data) * 0.95)\n174:     train_data = all_data[:eval_split_index]\n175:     eval_data = all_data[eval_split_index:] if eval_split_index < len(all_data) else all_data[:1]\n176: \n177:     train_file = output_dir / \"train_data.jsonl\"\n178:     eval_file = output_dir / \"eval_data.jsonl\"\n179: \n180:     print(f\"[*] Writing {len(train_data)} train samples to {train_file}...\")\n181:     with open(train_file, \"w\", encoding=\"utf-8\") as f:\n182:         for entry in train_data:\n183:             f.write(json.dumps(entry, ensure_ascii=False) + \"\\n\")\n184: \n185:     print(f\"[*] Writing {len(eval_data)} validation samples to {eval_file}...\")\n186:     with open(eval_file, \"w\", encoding=\"utf-8\") as f:\n187:         for entry in